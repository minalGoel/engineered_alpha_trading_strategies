//@version=5

// ═══════════════════════════════════════════════════════════════════════════════
// MULTI-DAY MOMENTUM — Nifty Futures
//
// APPLY TO: NIFTY1! continuous back-adjusted futures, DAILY resolution
//
// Edge: Equity index momentum at 1-4 week horizons. FII flow persistence
// creates multi-day trends on Nifty. When 5-day ROC exceeds threshold with
// EMA and daily-close confirmation, enter in the momentum direction.
// Hold 2-5 trading days. Target 200 pts, stop 100 pts.
//
// Cost: ~₹907 RT regulatory (0.028%/side) + ~₹260 execution buffer = ~18 pts
//       At 200 pt target: 9% cost ratio. R:R 200:100. Breakeven WR: 39%.
//       Best cost efficiency of all proposed strategies.
//
// Frequency: 4-8 trades/month (more in trending markets, fewer in ranges).
// Validation: 10+ years of daily data available. 500+ backtested trades.
//
// TIMING: Signal at today's close → entry at tomorrow's open
//         (process_orders_on_close=false on daily bars)
//
// COMMISSION NOTE: 0.028%/side per BACKTEST_RULES_INDIAN_FUTURES.md
//   This models STT 0.05% + exchange + SEBI + GST + stamp + brokerage
//   as a blended per-side percentage. Accurate within ±5%.
//   slippage=2 = 2 ticks = 0.10 pts (bid-ask on NIFTY futures).
//   Real-world execution adds ~4 pts unmodeled buffer (latency, adverse fill).
// ═══════════════════════════════════════════════════════════════════════════════

strategy("Multi-Day Momentum", overlay=true,
  initial_capital=500000,
  default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.percent, commission_value=0.028,
  slippage=2,
  process_orders_on_close=false,
  calc_on_every_tick=false)

// ─── INPUTS (5) ─────────────────────────────────────────────────────────────
i_roc_len = input.int(5,      "1. ROC Lookback (days)",  minval=3, maxval=20, tooltip="5-day momentum. Shorter = more signals + noise. Longer = fewer + smoother.")
i_roc_thr = input.float(0.80, "2. ROC Threshold (%)",    step=0.1, tooltip="Min 5-day return. 0.8% ≈ 190 pts on Nifty 23,500. Filters noise from real momentum.")
i_tgt     = input.float(200.0,"3. Target (pts)",          step=10.0, tooltip="200 pts = 9% cost ratio at 18 pts all-in. Breakeven WR: 39%.")
i_stop    = input.float(100.0,"4. Stop (pts)",            step=10.0, tooltip="Wide enough to survive 1-day adverse moves. A 100-pt adverse gap ≈ 0.4%.")
i_trail   = input.float(80.0, "5. Trail Offset (pts)",    step=10.0, tooltip="Trail follows peak at this distance. Locks in gains on multi-day runners.")

// ─── HARDCODED CONSTANTS ────────────────────────────────────────────────────
EMA_LEN    = 10     // 10-day EMA for trend confirmation
VIX_MAX    = 22.0   // exclude crisis / high-vol regimes
MAX_HOLD   = 5      // max hold in trading days (from fill bar)

// ─── VIX ────────────────────────────────────────────────────────────────────
// Today's VIX close is known at signal time (signal fires at daily close)
vix    = request.security("NSE:INDIAVIX", "D", close)
vix_ok = na(vix) or vix < VIX_MAX

// ─── EXPIRY EXCLUSION ───────────────────────────────────────────────────────
// Monthly expiry = last Thursday of month (falls on 25th-31st).
// Exclude Wed+Thu when day-of-month >= 25 to avoid rollover distortion.
// This over-excludes by ~2-4 days/year (non-expiry late-month Wed/Thu) — acceptable.
dom      = dayofmonth(time)
is_thu   = dayofweek(time) == dayofweek.thursday
is_wed   = dayofweek(time) == dayofweek.wednesday
near_exp = dom >= 25 and (is_thu or is_wed)

// ─── INDICATORS ─────────────────────────────────────────────────────────────
roc = (close - close[i_roc_len]) / close[i_roc_len] * 100
ema = ta.ema(close, EMA_LEN)

// ─── ENTRY CONDITIONS ───────────────────────────────────────────────────────
// 5 conditions for long (mirror for short):
//   1. ROC > threshold (momentum is real)
//   2. Close > 10-day EMA (above recent average, not a dead-cat bounce)
//   3. Today was an up day (momentum continuing, not stalling)
//   4. VIX < 22 (trend regime, not crisis)
//   5. Not near monthly expiry (avoid rollover)
flat   = strategy.position_size == 0
up_day = close > close[1]
dn_day = close < close[1]

go_l = flat and roc >  i_roc_thr and close > ema and up_day and vix_ok and not near_exp
go_s = flat and roc < -i_roc_thr and close < ema and dn_day and vix_ok and not near_exp

// ─── ENTRY ──────────────────────────────────────────────────────────────────
// Signal at today's close → fill at tomorrow's open
if go_l
    strategy.entry("L", strategy.long, comment="Mom")
if go_s
    strategy.entry("S", strategy.short, comment="Mom")

// ─── TRACK FILL BAR (for time stop) ────────────────────────────────────────
var int fill_bar = 0
if strategy.position_size != 0 and nz(strategy.position_size[1]) == 0
    fill_bar := bar_index

held = strategy.position_size != 0 ? bar_index - fill_bar : 0

// ─── EXITS: TARGET + STOP + TRAIL ──────────────────────────────────────────
// Trail activates at 50% of target. Once active, follows peak at i_trail behind.
// On daily bars, strategy.exit checks intrabar OHLC — stop/target can trigger
// within the day even though close_all orders wait for next open.
tgt_t     = math.round(i_tgt / syminfo.mintick)
stp_t     = math.round(i_stop / syminfo.mintick)
trail_act = math.round(i_tgt * 0.50 / syminfo.mintick)
trail_off = math.round(i_trail / syminfo.mintick)

if strategy.position_size > 0
    strategy.exit("XL", "L", profit=tgt_t, loss=stp_t,
      trail_points=trail_act, trail_offset=trail_off)
if strategy.position_size < 0
    strategy.exit("XS", "S", profit=tgt_t, loss=stp_t,
      trail_points=trail_act, trail_offset=trail_off)

// ─── SIGNAL REVERSAL EXIT ──────────────────────────────────────────────────
// If 5-day ROC crosses back through zero, momentum has stalled → exit.
// Grace period: don't check for first 2 days after fill (give the trade time).
// Fires at next bar's open (process_orders_on_close=false).
grace = held < 2
if strategy.position_size > 0 and roc <= 0 and not grace
    strategy.close_all(comment="ROC_Rev")
if strategy.position_size < 0 and roc >= 0 and not grace
    strategy.close_all(comment="ROC_Rev")

// ─── TIME STOP (5 trading days) ────────────────────────────────────────────
if strategy.position_size != 0 and held >= MAX_HOLD
    strategy.close_all(comment="Time")

// ─── PLOTS ──────────────────────────────────────────────────────────────────
plot(ema, "EMA(10)", color.blue, linewidth=2)

// Background: green tint during bullish momentum regime, red during bearish
is_bull = roc > i_roc_thr and close > ema
is_bear = roc < -i_roc_thr and close < ema
bgcolor(is_bull ? color.new(color.green, 90) : is_bear ? color.new(color.red, 90) : na, title="Momentum Regime")
