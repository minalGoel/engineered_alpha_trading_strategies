    ],
    "thesis": "Volatility is cyclical; periods of low volatility (squeeze) are followed by explosive expansion. Breakouts from the squeeze predict the direction of the expansion. Exists because prolonged consolidation builds unexecuted order book resting liquidity.",
    "universe": "nifty50",
    "stock_filter": "top 50 by avg volume in universe",
    "timeframe": "5min",
    "session": "09:30-15:15",
    "hold_time": "5-15 bars",
    "max_hold_bars": 60,
    "trades_per_day": "2-5",
    "max_trades_per_day": 8,
    "data": {
        "ohlcv_1min": true,
        "vwap": true,
        "vix": true,
        "index": "nifty50",
        "option_chain": false,
        "order_book": false,
        "other": []
    },
    "indicators": [
        {
            "name": "bb_upper",
            "formula": "SMA(close, 20) + 2*STDDEV(close, 20)",
            "lookback": 20,
            "purpose": "upper band"
        },
        {
            "name": "bb_lower",
            "formula": "SMA(close, 20) - 2*STDDEV(close, 20)",
            "lookback": 20,
            "purpose": "lower band"
        },
        {
            "name": "keltner_upper",
            "formula": "EMA(close, 20) + 1.5*ATR(20)",
            "lookback": 20,
            "purpose": "squeeze check"
        },
        {
            "name": "keltner_lower",
            "formula": "EMA(close, 20) - 1.5*ATR(20)",
            "lookback": 20,
            "purpose": "squeeze check"
        }
    ],
    "entry": {
        "long": {
            "conditions": [
                "bb_upper < keltner_upper AND bb_lower > keltner_lower AND close > bb_upper"
            ],
            "confirmation": "volume surge"
        },
        "short": {
            "conditions": [
                "bb_upper < keltner_upper AND bb_lower > keltner_lower AND close < bb_lower"
            ],
            "confirmation": "volume surge"
        },
        "entry_price": "market"
    },
    "exit": {
        "target": "close crosses SMA(close, 20)",
        "stop_loss": "1.5 * ATR(14) below entry",
        "trailing_stop": "move SL to breakeven after +0.5%",
        "time_stop": "exit after 60 bars",
        "eod_rule": "flatten",
        "signal_exit": "none"
    },
    "risk": {
        "capital_per_trade": 200000,
        "max_risk_per_trade_pct": 1.0,
        "position_sizing": "vol_adjusted",
        "max_open_positions": 3,
