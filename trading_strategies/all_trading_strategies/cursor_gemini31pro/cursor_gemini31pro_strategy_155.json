            "name": "pdh",
            "formula": "REF(high, 1, 'day')",
            "lookback": 1,
            "purpose": "liquidity pool above"
        },
        {
            "name": "pdl",
            "formula": "REF(low, 1, 'day')",
            "lookback": 1,
            "purpose": "liquidity pool below"
        }
    ],
    "entry": {
