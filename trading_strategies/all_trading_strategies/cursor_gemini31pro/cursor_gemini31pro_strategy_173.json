            "name": "prev_high",
            "formula": "REF(high, 1)",
            "lookback": 1,
            "purpose": "inside bar high"
        },
        {
            "name": "prev_low",
            "formula": "REF(low, 1)",
            "lookback": 1,
            "purpose": "inside bar low"
        },
        {
            "name": "is_inside",
            "formula": "high < prev_high AND low > prev_low",
            "lookback": 1,
            "purpose": "condition check"
        }
    ],
    "entry": {
        "long": {
            "conditions": [
                "REF(is_inside, 1) AND close > REF(prev_high, 1)"
