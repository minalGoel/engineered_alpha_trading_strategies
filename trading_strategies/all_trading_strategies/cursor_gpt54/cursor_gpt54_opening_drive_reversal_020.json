{
  "name": "opening_drive_reversal_020",
  "version": "0.1.0",
  "author": "cursor-fast",
  "tags": [
    "mean_reversion",
    "opening_reversal",
    "microstructure",
    "intraday"
  ],
  "thesis": "This strategy exploits opening-drive exhaustion after the first burst of post-auction directional flow in liquid NSE names. The inefficiency exists because market orders, stop runs, and emotional retail participation exaggerate the initial impulse, and it persists because fading the open is operationally hard, path-dependent, and vulnerable to real information gaps.",
  "universe": "fno",
  "stock_filter": "top 120 by 20-day median traded value in FnO, price > 100",
  "timeframe": "1min",
  "session": "09:20-10:15",
  "hold_time": "5-18 bars",
  "max_hold_bars": 18,
  "trades_per_day": "2-5",
  "max_trades_per_day": 5,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": [
      "wick ratios",
      "opening impulse measures"
    ]
  },
  "indicators": [
    {
      "name": "vwap",
      "formula": "VWAP()",
      "lookback": 390,
      "purpose": "intraday fair value anchor"
    },
    {
      "name": "atr_14",
      "formula": "ATR(14)",
      "lookback": 14,
      "purpose": "volatility normalization"
    },
    {
      "name": "rel_volume_20",
      "formula": "volume / SMA(volume, 20)",
      "lookback": 20,
      "purpose": "participation filter"
    },
    {
      "name": "rsi_fast",
      "formula": "RSI(close, 5)",
      "lookback": 5,
      "purpose": "opening exhaustion"
    },
    {
      "name": "wick_down_ratio",
      "formula": "(MIN(open, close) - low) / NULLIF(high - low, 0.0001)",
      "lookback": 1,
      "purpose": "reversal wick"
    },
    {
      "name": "wick_up_ratio",
      "formula": "(high - MAX(open, close)) / NULLIF(high - low, 0.0001)",
      "lookback": 1,
      "purpose": "reversal wick"
    },
    {
      "name": "vwap_slope_5",
      "formula": "vwap - vwap[-5]",
      "lookback": 5,
      "purpose": "trend avoidance"
    },
    {
      "name": "index_return_5",
      "formula": "NIFTY50_close / NIFTY50_close[-5] - 1",
      "lookback": 5,
      "purpose": "broad tape confirmation"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "close <= vwap * 0.992",
        "rsi_fast <= 20",
        "wick_down_ratio >= 0.35",
        "ABS(vwap_slope_5) <= 0.08 * atr_14",
        "rel_volume_20 >= 1.5",
        "index_return_5 > -0.003"
      ],
      "confirmation": "close > open"
    },
    "short": {
      "conditions": [
        "close >= vwap * 1.008",
        "rsi_fast >= 80",
        "wick_up_ratio >= 0.35",
        "ABS(vwap_slope_5) <= 0.08 * atr_14",
        "rel_volume_20 >= 1.5",
        "index_return_5 < 0.003"
      ],
      "confirmation": "close < open"
    },
    "entry_price": "close of signal bar"
  },
  "exit": {
    "target": "session vwap or first 0.60% move, whichever comes first",
    "stop_loss": "signal bar extreme or 0.45% from entry, whichever is farther",
    "trailing_stop": "none",
    "time_stop": "exit after 18 bars",
    "eod_rule": "flatten",
    "signal_exit": "exit when close touches vwap OR opening impulse resumes through signal bar extreme"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.55,
    "position_sizing": "fixed",
    "max_open_positions": 1,
    "max_daily_loss_inr": 4500,
    "max_portfolio_heat_pct": 1.25
  },
  "filters": {
    "vix_filter": "vix < 20",
    "time_filter": "only 09:20-10:15",
    "volume_filter": "skip if rel_volume_20 < 1.4",
    "trend_filter": "do not trade when ABS(index_return_5) > 0.5%",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": [
      "skip if first 15-minute range > 1.8 * atr_14"
    ]
  },
  "edge": {
    "expected_bps": 31,
    "win_rate_estimate": 0.64,
    "avg_winner_to_loser": 1.4,
    "profit_factor_estimate": 2.49,
    "edge_decay_risk": "medium — behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Performance is regime-dependent and weakens materially when session structure changes mid-trade.",
    "Fast moves can create worse-than-assumed slippage and reduce realized edge versus paper assumptions.",
    "Crowding risk can compress payoff and make execution quality unstable in the most obvious setups."
  ],
  "prior_art": "Opening drive fade with VWAP and wick confirmation",
  "notes": "Generated in a mixed-model batch under cursor-fast. Family: opening_drive_reversal. Use for research only until walk-forward and paper-trading validation are complete."
}