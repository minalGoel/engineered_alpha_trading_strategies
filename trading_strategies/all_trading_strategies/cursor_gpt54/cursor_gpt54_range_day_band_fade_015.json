{
  "name": "range_day_band_fade_015",
  "version": "0.1.0",
  "author": "cursor-fast",
  "tags": [
    "mean_reversion",
    "range_day",
    "vwap",
    "bands"
  ],
  "thesis": "This strategy exploits overreaction inside intraday range regimes where price moves too far from fair value without broad directional sponsorship. The inefficiency exists because many traders mechanically chase local strength or weakness even when the tape is rotational, and it persists because the edge vanishes on trend days.",
  "universe": "nifty200",
  "stock_filter": "top 150 by 20-day median traded value in NIFTY200, price > 80",
  "timeframe": "1min",
  "session": "10:15-14:15",
  "hold_time": "5-22 bars",
  "max_hold_bars": 22,
  "trades_per_day": "2-5",
  "max_trades_per_day": 4,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": true,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": [
      "Bollinger bands",
      "oscillator extremes"
    ]
  },
  "indicators": [
    {
      "name": "vwap",
      "formula": "VWAP()",
      "lookback": 390,
      "purpose": "intraday fair value anchor"
    },
    {
      "name": "atr_14",
      "formula": "ATR(14)",
      "lookback": 14,
      "purpose": "volatility normalization"
    },
    {
      "name": "rel_volume_20",
      "formula": "volume / SMA(volume, 20)",
      "lookback": 20,
      "purpose": "participation filter"
    },
    {
      "name": "adx_14",
      "formula": "ADX(14)",
      "lookback": 14,
      "purpose": "range filter"
    },
    {
      "name": "vwap_slope_10",
      "formula": "vwap - vwap[-10]",
      "lookback": 10,
      "purpose": "flat tape filter"
    },
    {
      "name": "bb_upper",
      "formula": "SMA(close, 20) + 2.2 * STDDEV(close, 20)",
      "lookback": 20,
      "purpose": "stretch band"
    },
    {
      "name": "bb_lower",
      "formula": "SMA(close, 20) - 2.2 * STDDEV(close, 20)",
      "lookback": 20,
      "purpose": "stretch band"
    },
    {
      "name": "mfi_5",
      "formula": "MFI(5)",
      "lookback": 5,
      "purpose": "oscillator"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "adx_14 <= 20",
        "ABS(vwap_slope_10) <= 0.08 * atr_14",
        "close <= vwap * 0.993",
        "close > bb_lower",
        "mfi_5 <= 20"
      ],
      "confirmation": "close > open"
    },
    "short": {
      "conditions": [
        "adx_14 <= 20",
        "ABS(vwap_slope_10) <= 0.08 * atr_14",
        "close >= vwap * 1.007",
        "close < bb_upper",
        "mfi_5 >= 80"
      ],
      "confirmation": "close < open"
    },
    "entry_price": "close of signal bar"
  },
  "exit": {
    "target": "session vwap or middle band, whichever hits first",
    "stop_loss": "0.45% from entry or 0.6 * atr_14 beyond signal extreme",
    "trailing_stop": "none",
    "time_stop": "exit after 22 bars",
    "eod_rule": "flatten",
    "signal_exit": "exit when adx_14 rises above 24 OR close crosses vwap"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.55,
    "position_sizing": "vol_adjusted",
    "max_open_positions": 1,
    "max_daily_loss_inr": 4500,
    "max_portfolio_heat_pct": 1.25
  },
  "filters": {
    "vix_filter": "vix between 12-24",
    "time_filter": "only 10:15-14:15",
    "volume_filter": "skip if rel_volume_20 < 1.8",
    "trend_filter": "only trade when session structure is range-like",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": [
      "skip if first 15-minute range > 1.8 * atr_14"
    ]
  },
  "edge": {
    "expected_bps": 25,
    "win_rate_estimate": 0.62,
    "avg_winner_to_loser": 1.3,
    "profit_factor_estimate": 2.12,
    "edge_decay_risk": "medium — behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Performance is regime-dependent and weakens materially when session structure changes mid-trade.",
    "Fast moves can create worse-than-assumed slippage and reduce realized edge versus paper assumptions.",
    "Crowding risk can compress payoff and make execution quality unstable in the most obvious setups."
  ],
  "prior_art": "Range-day Bollinger/Keltner style mean reversion",
  "notes": "Generated in a mixed-model batch under cursor-fast. Family: range_day_band_fade. Use for research only until walk-forward and paper-trading validation are complete."
}