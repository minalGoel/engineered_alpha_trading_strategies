{
  "name": "squeeze_release_breakout_005",
  "version": "0.1.0",
  "author": "gpt-5.4",
  "tags": [
    "breakout",
    "volatility",
    "squeeze",
    "momentum"
  ],
  "thesis": "This strategy exploits volatility expansion after intraday compression resolves with direction and volume. The inefficiency exists because traders reduce risk during compression and then chase once the move is obvious, and it persists because many breakouts fail without participation, so timing and capacity remain constrained.",
  "universe": "nifty500",
  "stock_filter": "top 200 by 20-day median traded value in NIFTY500, price > 80",
  "timeframe": "1min",
  "session": "10:00-14:30",
  "hold_time": "8-30 bars",
  "max_hold_bars": 30,
  "trades_per_day": "1-4",
  "max_trades_per_day": 3,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": [
      "keltner channel",
      "bollinger squeeze flag"
    ]
  },
  "indicators": [
    {
      "name": "vwap",
      "formula": "VWAP()",
      "lookback": 390,
      "purpose": "intraday fair value anchor"
    },
    {
      "name": "atr_14",
      "formula": "ATR(14)",
      "lookback": 14,
      "purpose": "volatility normalization"
    },
    {
      "name": "rel_volume_20",
      "formula": "volume / SMA(volume, 20)",
      "lookback": 20,
      "purpose": "participation filter"
    },
    {
      "name": "bb_upper",
      "formula": "SMA(close, 20) + 2 * STDDEV(close, 20)",
      "lookback": 20,
      "purpose": "compression envelope"
    },
    {
      "name": "bb_lower",
      "formula": "SMA(close, 20) - 2 * STDDEV(close, 20)",
      "lookback": 20,
      "purpose": "compression envelope"
    },
    {
      "name": "kc_upper",
      "formula": "EMA(close, 20) + 1.5 * ATR(20)",
      "lookback": 20,
      "purpose": "compression envelope"
    },
    {
      "name": "kc_lower",
      "formula": "EMA(close, 20) - 1.5 * ATR(20)",
      "lookback": 20,
      "purpose": "compression envelope"
    },
    {
      "name": "squeeze_on",
      "formula": "bb_upper < kc_upper AND bb_lower > kc_lower",
      "lookback": 20,
      "purpose": "compression state"
    },
    {
      "name": "ema_short",
      "formula": "EMA(close, 9)",
      "lookback": 9,
      "purpose": "directional trigger"
    },
    {
      "name": "ema_long",
      "formula": "EMA(close, 21)",
      "lookback": 21,
      "purpose": "directional trigger"
    },
    {
      "name": "squeeze_high",
      "formula": "HIGHEST(high, 10)",
      "lookback": 10,
      "purpose": "break level"
    },
    {
      "name": "squeeze_low",
      "formula": "LOWEST(low, 10)",
      "lookback": 10,
      "purpose": "break level"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "squeeze_on == True",
        "close > squeeze_high",
        "ema_short > ema_long",
        "close > vwap",
        "rel_volume_20 >= 1.6"
      ],
      "confirmation": "close > high[-1]"
    },
    "short": {
      "conditions": [
        "squeeze_on == True",
        "close < squeeze_low",
        "ema_short < ema_long",
        "close < vwap",
        "rel_volume_20 >= 1.6"
      ],
      "confirmation": "close < low[-1]"
    },
    "entry_price": "close of signal bar"
  },
  "exit": {
    "target": "2R fixed target with measured-move runner",
    "stop_loss": "opposite side of squeeze box",
    "trailing_stop": "trail by ema_short after +1R",
    "time_stop": "exit after 30 bars",
    "eod_rule": "flatten",
    "signal_exit": "exit when close closes back inside squeeze range"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.7,
    "position_sizing": "vol_adjusted",
    "max_open_positions": 1,
    "max_daily_loss_inr": 5000,
    "max_portfolio_heat_pct": 1.5
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "only 10:00-14:30",
    "volume_filter": "require rel_volume_20 >= 1.6",
    "trend_filter": "prefer trades aligned with NIFTY50 VWAP direction",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": [
      "skip if setup occurs after 14:30"
    ]
  },
  "edge": {
    "expected_bps": 25,
    "win_rate_estimate": 0.44,
    "avg_winner_to_loser": 1.95,
    "profit_factor_estimate": 1.53,
    "edge_decay_risk": "medium — structural"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Performance is regime-dependent and weakens materially when session structure changes mid-trade.",
    "Fast moves can create worse-than-assumed slippage and reduce realized edge versus paper assumptions.",
    "Crowding risk can compress payoff and make execution quality unstable in the most obvious setups."
  ],
  "prior_art": "TTM-style squeeze breakout adapted to 1-minute equities",
  "notes": "Generated in a mixed-model batch under gpt-5.4. Family: squeeze_release_breakout. Use for research only until walk-forward and paper-trading validation are complete."
}