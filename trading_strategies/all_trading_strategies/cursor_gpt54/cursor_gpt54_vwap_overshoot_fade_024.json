      "name": "vwap",
      "formula": "VWAP()",
      "lookback": 390,
      "purpose": "intraday fair value anchor"
    },
    {
      "name": "atr_14",
      "formula": "ATR(14)",
      "lookback": 14,
      "purpose": "volatility normalization"
    },
    {
      "name": "rel_volume_20",
      "formula": "volume / SMA(volume, 20)",
      "lookback": 20,
      "purpose": "participation filter"
    },
    {
      "name": "rsi_fast",
      "formula": "RSI(close, 3)",
