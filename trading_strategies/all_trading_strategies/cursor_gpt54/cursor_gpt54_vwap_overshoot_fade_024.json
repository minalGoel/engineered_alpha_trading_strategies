    },
    {
      "name": "adx_14",
      "formula": "ADX(14)",
      "lookback": 14,
      "purpose": "trend filter"
    },
    {
      "name": "bb_upper",
      "formula": "SMA(close, 20) + 2 * STDDEV(close, 20)",
      "lookback": 20,
      "purpose": "stretch band"
    },
    {
      "name": "bb_lower",
      "formula": "SMA(close, 20) - 2 * STDDEV(close, 20)",
      "lookback": 20,
      "purpose": "stretch band"
    },
    {
      "name": "index_return_15",
      "formula": "NIFTY50_close / NIFTY50_close[-15] - 1",
