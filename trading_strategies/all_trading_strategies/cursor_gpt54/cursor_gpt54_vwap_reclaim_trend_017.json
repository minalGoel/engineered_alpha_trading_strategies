{
  "name": "vwap_reclaim_trend_017",
  "version": "0.1.0",
  "author": "cursor-fast",
  "tags": [
    "momentum",
    "vwap",
    "trend_following",
    "continuation"
  ],
  "thesis": "This strategy exploits trend continuation after a temporary VWAP dislocation is absorbed and price reclaims the benchmark. The inefficiency exists because many intraday participants use VWAP as a risk-transfer anchor and re-enter only after confirmation, and it persists because chop regimes create frequent fake reclaims.",
  "universe": "nifty200",
  "stock_filter": "top 150 by 20-day median traded value in NIFTY200, price > 80",
  "timeframe": "1min",
  "session": "09:35-13:30",
  "hold_time": "8-24 bars",
  "max_hold_bars": 24,
  "trades_per_day": "1-4",
  "max_trades_per_day": 3,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": [
      "count(close relative to vwap)"
    ]
  },
  "indicators": [
    {
      "name": "vwap",
      "formula": "VWAP()",
      "lookback": 390,
      "purpose": "intraday fair value anchor"
    },
    {
      "name": "atr_14",
      "formula": "ATR(14)",
      "lookback": 14,
      "purpose": "volatility normalization"
    },
    {
      "name": "rel_volume_20",
      "formula": "volume / SMA(volume, 20)",
      "lookback": 20,
      "purpose": "participation filter"
    },
    {
      "name": "ema_short",
      "formula": "EMA(close, 9)",
      "lookback": 9,
      "purpose": "reclaim trigger"
    },
    {
      "name": "ema_long",
      "formula": "EMA(close, 21)",
      "lookback": 21,
      "purpose": "trend structure"
    },
    {
      "name": "adx_14",
      "formula": "ADX(14)",
      "lookback": 14,
      "purpose": "trend strength"
    },
    {
      "name": "below_vwap_count",
      "formula": "COUNT(close < vwap, 8)",
      "lookback": 8,
      "purpose": "precondition for reclaim"
    },
    {
      "name": "above_vwap_count",
      "formula": "COUNT(close > vwap, 8)",
      "lookback": 8,
      "purpose": "precondition for breakdown"
    },
    {
      "name": "index_vwap_dev",
      "formula": "(NIFTY50_close - NIFTY50_VWAP) / NIFTY50_VWAP",
      "lookback": 390,
      "purpose": "market alignment"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "below_vwap_count >= 6",
        "close > vwap",
        "ema_short > ema_long",
        "adx_14 >= 20",
        "index_vwap_dev >= 0"
      ],
      "confirmation": "close > high[-1]"
    },
    "short": {
      "conditions": [
        "above_vwap_count >= 6",
        "close < vwap",
        "ema_short < ema_long",
        "adx_14 >= 20",
        "index_vwap_dev <= 0"
      ],
      "confirmation": "close < low[-1]"
    },
    "entry_price": "close of signal bar"
  },
  "exit": {
    "target": "2R fixed target with optional runner to 3R on strong trend days",
    "stop_loss": "0.8 * ATR(14) from entry or reclaim bar extreme, whichever is farther",
    "trailing_stop": "trail by ema_short after +1R",
    "time_stop": "exit after 24 bars",
    "eod_rule": "flatten",
    "signal_exit": "exit when close crosses back through vwap"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.65,
    "position_sizing": "vol_adjusted",
    "max_open_positions": 1,
    "max_daily_loss_inr": 5000,
    "max_portfolio_heat_pct": 1.5
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "only 09:35-13:30",
    "volume_filter": "require rel_volume_20 >= 1.2",
    "trend_filter": "only align with NIFTY50 VWAP direction",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": [
      "skip if setup occurs after 14:30"
    ]
  },
  "edge": {
    "expected_bps": 32,
    "win_rate_estimate": 0.47,
    "avg_winner_to_loser": 1.7,
    "profit_factor_estimate": 1.51,
    "edge_decay_risk": "medium — structural"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Performance is regime-dependent and weakens materially when session structure changes mid-trade.",
    "Fast moves can create worse-than-assumed slippage and reduce realized edge versus paper assumptions.",
    "Crowding risk can compress payoff and make execution quality unstable in the most obvious setups."
  ],
  "prior_art": "VWAP reclaim continuation with EMA/ADX filter",
  "notes": "Generated in a mixed-model batch under cursor-fast. Family: vwap_reclaim_trend. Use for research only until walk-forward and paper-trading validation are complete."
}