{
  "name": "afternoon_profit_fade",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": ["mean_reversion"],
  "thesis": "Exploits intraday profit booking. Intraday traders in India typically flatten positions between 14:30 and 15:15 to avoid margin penalties or overnight risk. This creates a predictable mean-reversion counter-move to the day's primary trend. Arbitrage is limited by the short time window before the close.",
  "universe": "nifty100",
  "stock_filter": "stocks with daily move > 3%",
  "timeframe": "1min",
  "session": "14:45-15:20",
  "hold_time": "15-30 bars",
  "max_hold_bars": 40,
  "trades_per_day": "1 per stock",
  "max_trades_per_day": 5,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": false,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "day_return",
      "formula": "(close - prev_close) / prev_close",
      "lookback": 375,
      "purpose": "trend_strength"
    }
  ],
  "entry": {
    "long": {
      "conditions": ["time == 14:45", "day_return < -0.03", "close < vwap"],
      "confirmation": "none"
    },
    "short": {
      "conditions": ["time == 14:45", "day_return > 0.03", "close > vwap"],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "vwap touch",
    "stop_loss": "0.5% from entry",
    "trailing_stop": "none",
    "time_stop": "flatten at 15:25",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 150000,
    "max_risk_per_trade_pct": 0.5,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 2000,
    "max_portfolio_heat_pct": 1.0
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "exactly at 14:45",
    "volume_filter": "none",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 23.0,
    "win_rate_estimate": 0.52,
    "avg_winner_to_loser": 1.7,
    "profit_factor_estimate": 1.84,
    "edge_decay_risk": "low — structural"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Short squeeze can accelerate instead of fading",
    "Liquidity drops sharply in the last 15 mins"
  ],
  "prior_art": "Intraday Trend Reversal",
  "notes": "Only trades the extremes."
}
