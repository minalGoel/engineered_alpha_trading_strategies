{
  "name": "adx_strong_trend_pullback",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": ["trend_following"],
  "thesis": "Exploits institutional accumulation. When ADX > 25, the market is in a structural trend. Retail traders attempt to pick tops/bottoms, causing shallow pullbacks to the 20 EMA. These pullbacks are absorbed by trend-following institutional algos. This persistent imbalance creates the edge.",
  "universe": "nifty100",
  "stock_filter": "top 10 by ADX(14)",
  "timeframe": "1min",
  "session": "10:00-14:30",
  "hold_time": "40-100 bars",
  "max_hold_bars": 200,
  "trades_per_day": "2-4",
  "max_trades_per_day": 10,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": false,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "adx_14",
      "formula": "ADX(14)",
      "lookback": 14,
      "purpose": "trend_strength"
    },
    {
      "name": "ema_20",
      "formula": "EMA(close, 20)",
      "lookback": 20,
      "purpose": "entry_level"
    }
  ],
  "entry": {
    "long": {
      "conditions": ["adx_14 > 25", "plus_di > minus_di", "low <= ema_20", "close > ema_20"],
      "confirmation": "none"
    },
    "short": {
      "conditions": ["adx_14 > 25", "minus_di > plus_di", "high >= ema_20", "close < ema_20"],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "2 * ATR(14) from entry",
    "stop_loss": "1.5 * ATR(14) from entry",
    "trailing_stop": "ATR(14) trail",
    "time_stop": "none",
    "eod_rule": "flatten",
    "signal_exit": "adx crosses below 20"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.4,
    "position_sizing": "vol_adjusted",
    "max_open_positions": 3,
    "max_daily_loss_inr": 2000,
    "max_portfolio_heat_pct": 1.2
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "10:00-14:30",
    "volume_filter": "none",
    "trend_filter": "adx > 25",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 22.0,
    "win_rate_estimate": 0.53,
    "avg_winner_to_loser": 1.4,
    "profit_factor_estimate": 1.58,
    "edge_decay_risk": "low — structural"
  },
  "costs": {
    "slippage_bps_per_side": 2,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Late-stage trend entries ('buying the end')",
    "ADX lag in choppy markets"
  ],
  "prior_art": "Welles Wilder ADX System",
  "notes": "Standard trend-following setup, requires high win rate."
}
