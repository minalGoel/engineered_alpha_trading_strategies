{
  "name": "vwap_zscore_mean_reversion",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": ["mean_reversion", "vwap", "stat_arb"],
  "thesis": "Exploits short-term liquidity voids. Institutional VWAP-tracking algos create temporary over-extensions when large blocks are executed too fast. These deviations (3+ standard deviations) are statistically unlikely to persist in a non-trending regime. Arbitrage is difficult because of the precision required in timing the 'snap-back' against 1-min volatility.",
  "universe": "nifty200",
  "stock_filter": "top 50 by 20-day avg volume",
  "timeframe": "1min",
  "session": "10:00-14:30",
  "hold_time": "15-45 bars",
  "max_hold_bars": 90,
  "trades_per_day": "1-2",
  "max_trades_per_day": 10,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "vwap_z",
      "formula": "(close - vwap) / rolling_std(close, 20)",
      "lookback": 20,
      "purpose": "entry_trigger"
    },
    {
      "name": "adx_14",
      "formula": "ADX(14)",
      "lookback": 14,
      "purpose": "trend_filter"
    }
  ],
  "entry": {
    "long": {
      "conditions": ["vwap_z < -3.0", "adx_14 < 20", "vix < 20"],
      "confirmation": "close > open"
    },
    "short": {
      "conditions": ["vwap_z > 3.0", "adx_14 < 20", "vix < 20"],
      "confirmation": "close < open"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "vwap touch",
    "stop_loss": "1.5 * ATR(20) from entry",
    "trailing_stop": "none",
    "time_stop": "exit after 60 bars if not hit",
    "eod_rule": "flatten",
    "signal_exit": "zscore crosses 0"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.5,
    "position_sizing": "vol_adjusted",
    "max_open_positions": 3,
    "max_daily_loss_inr": 2000,
    "max_portfolio_heat_pct": 1.5
  },
  "filters": {
    "vix_filter": "vix < 20",
    "time_filter": "10:00-14:30",
    "volume_filter": "none",
    "trend_filter": "adx < 20",
    "spread_filter": "spread < 0.05%",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 22.0,
    "win_rate_estimate": 0.54,
    "avg_winner_to_loser": 1.6,
    "profit_factor_estimate": 1.88,
    "edge_decay_risk": "medium — behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Trending days cause 'hanging' entries",
    "VIX spikes expand the Z-score bands too wide for targets"
  ],
  "prior_art": "Classic VWAP Mean Reversion",
  "notes": "Relies on mean-reverting character of large caps during mid-session."
}
