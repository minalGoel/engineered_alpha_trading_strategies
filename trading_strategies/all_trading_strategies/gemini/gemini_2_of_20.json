{
  "name": "opening_range_breakout_15",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": ["momentum", "breakout"],
  "thesis": "Exploits institutional price discovery in the first 15 mins. The high/low of the first 15 mins often acts as a boundary for the day's trend as orders from overnight news are processed. This isn't arbitraged because of the high slippage and volatility at the open.",
  "universe": "fno",
  "stock_filter": "top 20 gappers at 09:16",
  "timeframe": "1min",
  "session": "09:30-11:00",
  "hold_time": "30-120 bars",
  "max_hold_bars": 200,
  "trades_per_day": "1",
  "max_trades_per_day": 5,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": false,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "orb_high",
      "formula": "highest(high, 15) @ 09:30",
      "lookback": 15,
      "purpose": "breakout_level"
    },
    {
      "name": "orb_low",
      "formula": "lowest(low, 15) @ 09:30",
      "lookback": 15,
      "purpose": "breakout_level"
    }
  ],
  "entry": {
    "long": {
      "conditions": ["close > orb_high", "volume > sma(volume, 20) * 2"],
      "confirmation": "high > prev_high"
    },
    "short": {
      "conditions": ["close < orb_low", "volume > sma(volume, 20) * 2"],
      "confirmation": "low < prev_low"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "2.0 * (orb_high - orb_low) + entry",
    "stop_loss": "orb_low for long, orb_high for short",
    "trailing_stop": "move to breakeven at 1:1 RR",
    "time_stop": "none",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 1.0,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 3000,
    "max_portfolio_heat_pct": 2.0
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "09:30-11:00",
    "volume_filter": "rel_vol > 2.0",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 35.0,
    "win_rate_estimate": 0.42,
    "avg_winner_to_loser": 2.5,
    "profit_factor_estimate": 1.81,
    "edge_decay_risk": "low — structural"
  },
  "costs": {
    "slippage_bps_per_side": 5,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "False breakouts in choppy opens",
    "Large SL required if ORB range is wide"
  ],
  "prior_art": "Toby Crabel ORB",
  "notes": "High slippage at open must be modeled as 5 bps."
}
