{
  "name": "sector_relative_strength_momentum",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": ["momentum", "relative_strength"],
  "thesis": "Capitalizes on institutional 'herding' into sectors. When Nifty Bank outperforms Nifty 50, the strongest stock in the banking sector exhibits persistent intraday momentum as mutual funds rotate capital. Information lag in retail participants creates a 60-90 minute window of trend.",
  "universe": "fno",
  "stock_filter": "banking sector only",
  "timeframe": "1min",
  "session": "10:30-15:00",
  "hold_time": "60-180 bars",
  "max_hold_bars": 300,
  "trades_per_day": "1",
  "max_trades_per_day": 3,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": false,
    "index": "banknifty",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "rel_strength",
      "formula": "(stock_close/index_close) / sma(stock_close/index_close, 50)",
      "lookback": 50,
      "purpose": "stock_selection"
    },
    {
      "name": "index_ema",
      "formula": "EMA(index_close, 20)",
      "lookback": 20,
      "purpose": "regime_filter"
    }
  ],
  "entry": {
    "long": {
      "conditions": ["rel_strength > 1.02", "index_close > index_ema", "close > vwap"],
      "confirmation": "none"
    },
    "short": {
      "conditions": ["rel_strength < 0.98", "index_close < index_ema", "close < vwap"],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "fixed 0.8%",
    "stop_loss": "0.4% from entry",
    "trailing_stop": "EMA(close, 9) trail",
    "time_stop": "none",
    "eod_rule": "flatten",
    "signal_exit": "close crosses vwap"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.4,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 2000,
    "max_portfolio_heat_pct": 0.8
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "after 10:30",
    "volume_filter": "volume > sma(volume, 20)",
    "trend_filter": "index_alignment",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 28.0,
    "win_rate_estimate": 0.52,
    "avg_winner_to_loser": 1.8,
    "profit_factor_estimate": 1.95,
    "edge_decay_risk": "low — structural"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Sector rotation can reverse midday",
    "High correlation between open positions"
  ],
  "prior_art": "Standard Relative Strength Alpha",
  "notes": "Requires real-time Bank Nifty index data."
}
