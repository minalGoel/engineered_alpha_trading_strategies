{
  "name": "bollinger_squeeze_breakout",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": ["volatility", "momentum"],
  "thesis": "Exploits the transition from low volatility to high volatility. Markets are fractal; periods of extreme range contraction (Bollinger Bands inside Keltner Channels) lead to explosive breakouts. Behavioral bias: traders ignore quiet stocks, allowing the 'smart money' to build positions silently.",
  "universe": "nifty100",
  "stock_filter": "lowest 10% by 20-bar volatility",
  "timeframe": "1min",
  "session": "09:45-14:45",
  "hold_time": "30-100 bars",
  "max_hold_bars": 150,
  "trades_per_day": "1-3",
  "max_trades_per_day": 10,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": false,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "bb_width",
      "formula": "(upper_bb(20, 2) - lower_bb(20, 2)) / sma(close, 20)",
      "lookback": 20,
      "purpose": "vol_compression"
    },
    {
      "name": "keltner_mid",
      "formula": "EMA(close, 20)",
      "lookback": 20,
      "purpose": "trend_basis"
    }
  ],
  "entry": {
    "long": {
      "conditions": ["bb_width < 0.002", "close > upper_bb(20, 2)", "volume > prev_volume * 1.5"],
      "confirmation": "none"
    },
    "short": {
      "conditions": ["bb_width < 0.002", "close < lower_bb(20, 2)", "volume > prev_volume * 1.5"],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "2.5 * ATR(20) from entry",
    "stop_loss": "sma(close, 20)",
    "trailing_stop": "move SL to mid_bb after +0.5%",
    "time_stop": "none",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.5,
    "position_sizing": "fixed",
    "max_open_positions": 3,
    "max_daily_loss_inr": 2000,
    "max_portfolio_heat_pct": 1.5
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "none",
    "volume_filter": "rel_vol > 1.5",
    "trend_filter": "none",
    "spread_filter": "spread < 0.04%",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 27.0,
    "win_rate_estimate": 0.45,
    "avg_winner_to_loser": 2.2,
    "profit_factor_estimate": 1.8,
    "edge_decay_risk": "medium — structural"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Whipsaws inside the channel",
    "Squeeze can last longer than the intraday session"
  ],
  "prior_art": "John Carter Squeeze Pro",
  "notes": "Requires high-precision calculation of BB-width."
}
