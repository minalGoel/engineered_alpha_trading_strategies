{
  "name": "psychological_level_mean_reversion",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": ["mean_reversion", "microstructure"],
  "thesis": "Exploits round-number bias. Retail stop-loss orders and limit orders cluster at levels like 500, 1000, 1500. This creates artificial resistance/support. Price often 'pierces' these levels to hunt liquidity and then reverts. This is a behavioral constraint of retail-heavy markets like India.",
  "universe": "fno",
  "stock_filter": "stocks trading near 100s or 500s",
  "timeframe": "1min",
  "session": "full_day",
  "hold_time": "10-25 bars",
  "max_hold_bars": 40,
  "trades_per_day": "2-5",
  "max_trades_per_day": 10,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": false,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "is_round",
      "formula": "close % 100 == 0 OR close % 50 == 0",
      "lookback": 0,
      "purpose": "level_filter"
    },
    {
      "name": "dist",
      "formula": "abs(close - round(close/100)*100)",
      "lookback": 0,
      "purpose": "trigger"
    }
  ],
  "entry": {
    "long": {
      "conditions": ["dist < 0.2", "close < round(close/100)*100", "rsi(14) < 30"],
      "confirmation": "close > open"
    },
    "short": {
      "conditions": ["dist < 0.2", "close > round(close/100)*100", "rsi(14) > 70"],
      "confirmation": "close < open"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "fixed 0.4%",
    "stop_loss": "0.25% from entry",
    "trailing_stop": "none",
    "time_stop": "20 bars",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.3,
    "position_sizing": "fixed",
    "max_open_positions": 1,
    "max_daily_loss_inr": 1000,
    "max_portfolio_heat_pct": 0.3
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "none",
    "volume_filter": "volume > sma(volume, 20)",
    "trend_filter": "none",
    "spread_filter": "spread < 0.02%",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 21.0,
    "win_rate_estimate": 0.58,
    "avg_winner_to_loser": 1.2,
    "profit_factor_estimate": 1.65,
    "edge_decay_risk": "medium — behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 2,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Levels can 'blow through' during strong news",
    "Requires high liquidity to exit at round numbers"
  ],
  "prior_art": "Round Number Alpha",
  "notes": "Works best on high-priced stocks (e.g., RELIANCE, BAJFINANCE)."
}
