{
    "name": "opening_range_breakout_v1",
    "version": "0.1.0",
    "author": "AI_Quant",
    "tags": [
        "breakout",
        "momentum"
    ],
    "thesis": "This strategy uses the Opening Range Breakout (ORB): it enters when price breaks the high/low of the first 15-minutes of trading\u301010\u2020L48-L56\u3011. The idea is early volatility (reflecting overnight news and institutional orders) sets a directional bias, so breaking out signals continuation\u301010\u2020L137-L145\u3011. It persists because many traders wait passively, underreacting to the 'first hour' signal, and the OR levels are self-fulfilling reference points.",
    "universe": "nifty50",
    "stock_filter": "index_only",
    "timeframe": "1min",
    "session": "09:15-15:15",
    "hold_time": "5-20 bars",
    "max_hold_bars": 20,
    "trades_per_day": "1-2",
    "max_trades_per_day": 1,
    "data": {
        "ohlcv_1min": true,
        "vwap": false,
        "vix": false,
        "index": "nifty50",
        "option_chain": false,
        "order_book": false,
        "other": []
    },
    "indicators": [
        {
            "name": "or_high",
            "formula": "max(high, 15)",
            "lookback": 15,
            "purpose": "opening range high"
        },
        {
            "name": "or_low",
            "formula": "min(low, 15)",
            "lookback": 15,
            "purpose": "opening range low"
        }
    ],
    "entry": {
        "long": {
            "conditions": [
                "close > or_high"
            ],
            "confirmation": ""
        },
        "short": {
            "conditions": [
                "close < or_low"
            ],
            "confirmation": ""
        },
        "entry_price": "market"
    },
    "exit": {
        "target": "1.0% from entry",
        "stop_loss": "stop at other side of range (ORL for long, ORH for short)",
        "trailing_stop": "none",
        "time_stop": "exit after 20 bars",
        "eod_rule": "flatten",
        "signal_exit": ""
    },
    "risk": {
        "capital_per_trade": 100000,
        "max_risk_per_trade_pct": 1.0,
        "position_sizing": "fixed",
        "max_open_positions": 1,
        "max_daily_loss_inr": 100000,
        "max_portfolio_heat_pct": 50.0
    },
    "filters": {
        "vix_filter": "vix < 25",
        "time_filter": "",
        "volume_filter": "",
        "trend_filter": "",
        "spread_filter": "none",
        "event_filter": "none",
        "other_filters": []
    },
    "edge": {
        "expected_bps": 20,
        "win_rate_estimate": 0.5,
        "avg_winner_to_loser": 1.5,
        "profit_factor_estimate": 1.2,
        "edge_decay_risk": "high \u2014 crowded"
    },
    "costs": {
        "slippage_bps_per_side": 3,
        "brokerage": "zerodha_intraday",
        "stt_bps": 2.5,
        "exchange_charges_bps": 0.5
    },
    "weaknesses": [
        "High risk of false breakouts or breakout failures (whipsaws)",
        "Very sensitive to exact timeframe of opening range (overfitting risk)",
        "Strategy assumes sufficient volatility; may fail on calm days"
    ],
    "prior_art": "Classic Opening Range Breakout",
    "notes": "Uses first-15-minute OR levels. Typical for indices or liquid stocks."
}
