{
    "name": "rsi_reversal_v1",
    "version": "0.1.0",
    "author": "AI_Quant",
    "tags": [
        "mean_reversion",
        "momentum"
    ],
    "thesis": "This is an RSI-based reversal strategy. It bets that extreme RSI readings signal temporary exhaustion\u301012\u2020L169-L178\u3011. For example, RSI<30 in an oversold dip often precedes a bounce, and RSI>70 an overbought top. The inefficiency stems from behavioral overreaction: traders oversell/overbuy in short term, then price reverts. It persists due to noise and the difficulty of timing quick reversals.",
    "universe": "nifty200",
    "stock_filter": "top_fno",
    "timeframe": "1min",
    "session": "09:20-15:15",
    "hold_time": "2-15 bars",
    "max_hold_bars": 15,
    "trades_per_day": "5-10",
    "max_trades_per_day": 10,
    "data": {
        "ohlcv_1min": true,
        "vwap": false,
        "vix": true,
        "index": "none",
        "option_chain": false,
        "order_book": false,
        "other": []
    },
    "indicators": [
        {
            "name": "rsi14",
            "formula": "RSI(close, 14)",
            "lookback": 14,
            "purpose": "momentum oscillator"
        },
        {
            "name": "ema200",
            "formula": "EMA(close, 200)",
            "lookback": 200,
            "purpose": "long-term trend"
        }
    ],
    "entry": {
        "long": {
            "conditions": [
                "rsi14 < 30 AND close < ema200"
            ],
            "confirmation": ""
        },
        "short": {
            "conditions": [
                "rsi14 > 70 AND close > ema200"
            ],
            "confirmation": ""
        },
        "entry_price": "market"
    },
    "exit": {
        "target": "fixed 0.4%",
        "stop_loss": "fixed 0.2%",
        "trailing_stop": "none",
        "time_stop": "flatten at 15:29",
        "eod_rule": "flatten",
        "signal_exit": ""
    },
    "risk": {
        "capital_per_trade": 100000,
        "max_risk_per_trade_pct": 0.2,
        "position_sizing": "fixed",
        "max_open_positions": 2,
        "max_daily_loss_inr": 50000,
        "max_portfolio_heat_pct": 30.0
    },
    "filters": {
        "vix_filter": "vix < 25",
        "time_filter": "",
        "volume_filter": "volume > avg_20",
        "trend_filter": "",
        "spread_filter": "",
        "event_filter": "none",
        "other_filters": []
    },
    "edge": {
        "expected_bps": 20,
        "win_rate_estimate": 0.45,
        "avg_winner_to_loser": 1.5,
        "profit_factor_estimate": 1.0,
        "edge_decay_risk": "medium \u2014 behavioral"
    },
    "costs": {
        "slippage_bps_per_side": 3,
        "brokerage": "zerodha_intraday",
        "stt_bps": 2.5,
        "exchange_charges_bps": 0.5
    },
    "weaknesses": [
        "In strong trends, RSI can remain in extreme zone for long (momentum trap)",
        "False signals when RSI stays high/low during news events",
        "Profit factor near 1.0 means small edge and high sensitivity to costs"
    ],
    "prior_art": "Classic RSI reversal",
    "notes": "Use intraday RSI (<30 oversold, >70 overbought). Behavioral mean reversion play."
}
