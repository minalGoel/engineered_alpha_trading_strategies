{
    "name": "ema_crossover_v1",
    "version": "0.1.0",
    "author": "AI_Quant",
    "tags": [
        "momentum",
        "trend"
    ],
    "thesis": "This strategy captures short-term trend flips: when EMA9 crosses EMA21, it signals a momentum shift. Many traders focus on longer signals, so a quick cross can indicate a new trend phase. It exploits that older traders lag behind short-term moves. It persists due to continual market noise and the constant emergence of new trader participation.",
    "universe": "nifty500",
    "stock_filter": "sector_etf",
    "timeframe": "1min",
    "session": "09:20-15:15",
    "hold_time": "5-15 bars",
    "max_hold_bars": 15,
    "trades_per_day": "3-6",
    "max_trades_per_day": 6,
    "data": {
        "ohlcv_1min": true,
        "vwap": false,
        "vix": false,
        "index": "nifty50",
        "option_chain": false,
        "order_book": false,
        "other": []
    },
    "indicators": [
        {
            "name": "ema9",
            "formula": "EMA(close, 9)",
            "lookback": 9,
            "purpose": "short-term trend"
        },
        {
            "name": "ema21",
            "formula": "EMA(close, 21)",
            "lookback": 21,
            "purpose": "medium-term trend"
        }
    ],
    "entry": {
        "long": {
            "conditions": [
                "close > ema9 AND ema9 > ema21"
            ],
            "confirmation": ""
        },
        "short": {
            "conditions": [
                "close < ema9 AND ema9 < ema21"
            ],
            "confirmation": ""
        },
        "entry_price": "market"
    },
    "exit": {
        "target": "0.5% from entry",
        "stop_loss": "0.3% from entry",
        "trailing_stop": "none",
        "time_stop": "exit after 15 bars",
        "eod_rule": "flatten",
        "signal_exit": ""
    },
    "risk": {
        "capital_per_trade": 100000,
        "max_risk_per_trade_pct": 0.4,
        "position_sizing": "fixed",
        "max_open_positions": 3,
        "max_daily_loss_inr": 50000,
        "max_portfolio_heat_pct": 40.0
    },
    "filters": {
        "vix_filter": "",
        "time_filter": "",
        "volume_filter": "volume > avg_10",
        "trend_filter": "",
        "spread_filter": "",
        "event_filter": "none",
        "other_filters": []
    },
    "edge": {
        "expected_bps": 20,
        "win_rate_estimate": 0.5,
        "avg_winner_to_loser": 1.5,
        "profit_factor_estimate": 1.3,
        "edge_decay_risk": "medium \u2014 behavioral"
    },
    "costs": {
        "slippage_bps_per_side": 3,
        "brokerage": "zerodha_intraday",
        "stt_bps": 2.5,
        "exchange_charges_bps": 0.5
    },
    "weaknesses": [
        "Frequent whipsaws in sideways markets",
        "Small targets (0.5%) give tight edge which may be eroded by costs",
        "Relies on moving averages that lag during sudden moves"
    ],
    "prior_art": "Basic EMA crossover",
    "notes": "Classic short/medium EMA crossover strategy."
}
