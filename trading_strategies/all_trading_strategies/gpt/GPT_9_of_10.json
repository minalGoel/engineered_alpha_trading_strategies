{
    "name": "gap_fade_v1",
    "version": "0.1.0",
    "author": "AI_Quant",
    "tags": [
        "mean_reversion",
        "gap"
    ],
    "thesis": "This strategy fades large opening gaps. Empirically, many open gaps (>1%) tend to fill intraday, as initial momentum often retraces. It exploits behavioral overreaction at open. The inefficiency exists due to temporary mispricing of overnight information; it persists because traders hesitate to fade until pattern is proven (and overnight risk is resolved).",
    "universe": "nifty200",
    "stock_filter": "gap_candidates (opens 1%+)",
    "timeframe": "1min",
    "session": "09:15-15:15",
    "hold_time": "1-30 bars",
    "max_hold_bars": 30,
    "trades_per_day": "1-3",
    "max_trades_per_day": 2,
    "data": {
        "ohlcv_1min": true,
        "vwap": false,
        "vix": false,
        "index": "none",
        "option_chain": false,
        "order_book": false,
        "other": []
    },
    "indicators": [
        {
            "name": "open_gap",
            "formula": "(open - close[1]) / close[1]",
            "lookback": 1,
            "purpose": "percent gap at open"
        }
    ],
    "entry": {
        "long": {
            "conditions": [
                "open_gap < -0.01"
            ],
            "confirmation": ""
        },
        "short": {
            "conditions": [
                "open_gap > 0.01"
            ],
            "confirmation": ""
        },
        "entry_price": "market"
    },
    "exit": {
        "target": "0.5% from entry",
        "stop_loss": "0.3% from entry",
        "trailing_stop": "none",
        "time_stop": "exit after 30 bars or on gap fill",
        "eod_rule": "flatten",
        "signal_exit": ""
    },
    "risk": {
        "capital_per_trade": 100000,
        "max_risk_per_trade_pct": 0.3,
        "position_sizing": "fixed",
        "max_open_positions": 1,
        "max_daily_loss_inr": 50000,
        "max_portfolio_heat_pct": 20.0
    },
    "filters": {
        "vix_filter": "",
        "time_filter": "entry only in first 10 min",
        "volume_filter": "volume > avg_5",
        "trend_filter": "",
        "spread_filter": "none",
        "event_filter": "none",
        "other_filters": []
    },
    "edge": {
        "expected_bps": 20,
        "win_rate_estimate": 0.5,
        "avg_winner_to_loser": 2.0,
        "profit_factor_estimate": 1.6,
        "edge_decay_risk": "medium \u2014 behavioral"
    },
    "costs": {
        "slippage_bps_per_side": 3,
        "brokerage": "zerodha_intraday",
        "stt_bps": 2.5,
        "exchange_charges_bps": 0.5
    },
    "weaknesses": [
        "Some gaps are due to strong news and may continue trending",
        "Risk of reversals if news is not fully priced at open",
        "Limited signal frequency (requires significant gap at open)"
    ],
    "prior_art": "Gap fill",
    "notes": "Fades gaps open beyond 1%. Monitors within first hour primarily."
}
