{
  "name": "gap_momentum_v1",
  "version": "0.1.0",
  "author": "aggregated_from_x_indian_traders",
  "tags": [
    "gap",
    "momentum"
  ],
  "thesis": "Exploiting continuation of large gaps (>2%) driven by overnight news/institutional positioning. Inefficiency exists due to behavioral over-reaction by retail on open and information lag until first 1-min candle confirms direction. Hasn't been arbitraged away because strict 1-min confirmation + EOD flatten + costs make it unviable for high-frequency non-systematic traders in India.",
  "universe": "fno",
  "stock_filter": "stocks with |gap| > 2% and volume > 50% avg",
  "timeframe": "1min",
  "session": "09:20-15:15",
  "hold_time": "until EOD",
  "max_hold_bars": 360,
  "trades_per_day": "1-3",
  "max_trades_per_day": 4,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": [
      "prev_close",
      "gap_pct"
    ]
  },
  "indicators": [
    {
      "name": "gap_pct",
      "formula": "(open - prev_close) / prev_close",
      "lookback": null,
      "purpose": "gap size filter"
    },
    {
      "name": "signal_candle_dir",
      "formula": "close_1min_after_open > open",
      "lookback": 1,
      "purpose": "direction confirmation"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "gap_pct > 0.02",
        "signal_candle_dir == True",
        "vix < 20",
        "rel_volume > 1.3"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "gap_pct < -0.02",
        "signal_candle_dir == False",
        "vix < 20",
        "rel_volume > 1.3"
      ],
      "confirmation": "none"
    },
    "entry_price": "close of first 1-min bar"
  },
  "exit": {
    "target": "none",
    "stop_loss": "high/low of signal 1-min bar",
    "trailing_stop": "none",
    "time_stop": "none",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 300000,
    "max_risk_per_trade_pct": 0.4,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 30000,
    "max_portfolio_heat_pct": 1.0
  },
  "filters": {
    "vix_filter": "vix < 20",
    "time_filter": "only first 30 min",
    "volume_filter": "none",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "skip on expiry day",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 35,
    "win_rate_estimate": 0.55,
    "avg_winner_to_loser": 2.0,
    "profit_factor_estimate": 2.4,
    "edge_decay_risk": "low \u2014 structural"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Gap risk on open: adverse news after entry can cause immediate stop hits",
    "Liquidity constraints: huge slippage in low-float gap stocks",
    "VIX regime sensitivity: works only in low-VIX; fails in panic gaps"
  ],
  "prior_art": "Gap direction strategy (shared by @AlphaWizarDD on X)",
  "notes": "Directly from X trader threads; requires pre-open data handling."
}
