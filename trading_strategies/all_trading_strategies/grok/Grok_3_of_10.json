{
  "name": "open_high_low_v1",
  "version": "0.1.0",
  "author": "aggregated_from_x_indian_traders",
  "tags": [
    "price_action",
    "open_high_low"
  ],
  "thesis": "Exploiting stocks that make open=high or open=low on 1-min as strong directional bias due to institutional conviction at open. Inefficiency from retail chasing momentum without confirmation. Persists because most traders ignore volume filter + index alignment; costs kill discretionary versions.",
  "universe": "fno",
  "stock_filter": "top 30 FnO by volume",
  "timeframe": "1min",
  "session": "09:20-15:15",
  "hold_time": "15-60 bars",
  "max_hold_bars": 90,
  "trades_per_day": "3-7",
  "max_trades_per_day": 10,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "open_high_low_flag",
      "formula": "(open == high OR open == low) on first bar",
      "lookback": 1,
      "purpose": "signal"
    },
    {
      "name": "rel_volume",
      "formula": "volume / SMA(volume, 20)",
      "lookback": 20,
      "purpose": "confirmation"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "open_high_low_flag == True AND open == low",
        "rel_volume > 1.5",
        "vix < 21"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "open_high_low_flag == True AND open == high",
        "rel_volume > 1.5",
        "vix < 21"
      ],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "1.5 * ATR(14) from entry",
    "stop_loss": "open price",
    "trailing_stop": "none",
    "time_stop": "exit after 60 bars",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 400000,
    "max_risk_per_trade_pct": 0.25,
    "position_sizing": "fixed",
    "max_open_positions": 4,
    "max_daily_loss_inr": 35000,
    "max_portfolio_heat_pct": 1.0
  },
  "filters": {
    "vix_filter": "vix < 21",
    "time_filter": "first 15 min only",
    "volume_filter": "none",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 22,
    "win_rate_estimate": 0.57,
    "avg_winner_to_loser": 1.6,
    "profit_factor_estimate": 2.1,
    "edge_decay_risk": "medium \u2014 behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Regime dependency: worthless in ranging sideways opens",
    "Slippage on fast moves: open=high/low often coincides with news spikes",
    "Crowding: extremely popular on X leading to alpha decay in top names"
  ],
  "prior_art": "Open High Low strategy (classic X thread by @bhaveshp1509)",
  "notes": "Simple yet powerful; easy to code on 1-min data."
}
