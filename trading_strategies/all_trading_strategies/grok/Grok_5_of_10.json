{
  "name": "bollinger_price_action_v1",
  "version": "0.1.0",
  "author": "aggregated_from_x_indian_traders",
  "tags": [
    "mean_reversion",
    "bollinger"
  ],
  "thesis": "Exploiting price action rejection at Bollinger Band extremes in directional bias. Inefficiency from retail panic at bands without PA confirmation. Persists due to VIX filter requirement and institutional support at bands.",
  "universe": "fno",
  "stock_filter": "top 50 FnO",
  "timeframe": "1min",
  "session": "09:20-15:15",
  "hold_time": "5-20 bars",
  "max_hold_bars": 30,
  "trades_per_day": "4-8",
  "max_trades_per_day": 12,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "bb_upper",
      "formula": "BB(high, low, close, 20, 2)",
      "lookback": 20,
      "purpose": "upper band"
    },
    {
      "name": "bb_lower",
      "formula": "BB(high, low, close, 20, 2)",
      "lookback": 20,
      "purpose": "lower band"
    },
    {
      "name": "pinbar",
      "formula": "upper_wick > 2*body AND at band",
      "lookback": 1,
      "purpose": "rejection"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "close near bb_lower",
        "pinbar == True",
        "vix < 18",
        "nifty_return_5 > 0"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "close near bb_upper",
        "pinbar == True",
        "vix < 18",
        "nifty_return_5 < 0"
      ],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "middle band",
    "stop_loss": "1.0 * ATR(14) away",
    "trailing_stop": "none",
    "time_stop": "exit after 20 bars",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 300000,
    "max_risk_per_trade_pct": 0.3,
    "position_sizing": "fixed",
    "max_open_positions": 4,
    "max_daily_loss_inr": 30000,
    "max_portfolio_heat_pct": 1.2
  },
  "filters": {
    "vix_filter": "vix < 18",
    "time_filter": "none",
    "volume_filter": "rel_volume > 1.2",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 26,
    "win_rate_estimate": 0.61,
    "avg_winner_to_loser": 1.5,
    "profit_factor_estimate": 2.3,
    "edge_decay_risk": "medium \u2014 behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Regime dependency: trending markets ignore bands",
    "Slippage on fast moves: band touches during news",
    "Crowding: Bollinger setups widely discussed on X"
  ],
  "prior_art": "Price Action + Bollinger (shared by @Mohitsharma202 on X)",
  "notes": "Combines classic bands with Indian price action."
}
