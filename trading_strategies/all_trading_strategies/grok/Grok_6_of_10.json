{
  "name": "ema200_dip_reversal_v1",
  "version": "0.1.0",
  "author": "aggregated_from_x_indian_traders",
  "tags": [
    "mean_reversion",
    "support"
  ],
  "thesis": "Exploiting bounces from 200-period EMA on 5-min after multi-day support formation. Inefficiency from retail panic selling at visible levels. Not arbitraged because requires 2-day prior support + volume spike; costs + latency kill it for non-quants.",
  "universe": "nifty200",
  "stock_filter": "liquid names with multi-day support",
  "timeframe": "1min",
  "session": "09:20-15:15",
  "hold_time": "10-30 bars",
  "max_hold_bars": 50,
  "trades_per_day": "2-5",
  "max_trades_per_day": 7,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "ema_200_5min",
      "formula": "EMA(close aggregated to 5min, 200)",
      "lookback": 200,
      "purpose": "support level"
    },
    {
      "name": "multi_day_support",
      "formula": "price touched ema_200_5min on 2+ prior days",
      "lookback": null,
      "purpose": "filter"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "close > ema_200_5min - 0.5*ATR(20)",
        "multi_day_support == True",
        "rel_volume > 1.6",
        "vix < 19"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "NOT_APPLICABLE"
      ],
      "confirmation": ""
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "1.0 * ATR(20) above entry",
    "stop_loss": "below ema_200_5min",
    "trailing_stop": "none",
    "time_stop": "exit after 30 bars",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 400000,
    "max_risk_per_trade_pct": 0.25,
    "position_sizing": "fixed",
    "max_open_positions": 3,
    "max_daily_loss_inr": 30000,
    "max_portfolio_heat_pct": 0.8
  },
  "filters": {
    "vix_filter": "vix < 19",
    "time_filter": "none",
    "volume_filter": "none",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 23,
    "win_rate_estimate": 0.63,
    "avg_winner_to_loser": 1.4,
    "profit_factor_estimate": 2.4,
    "edge_decay_risk": "medium \u2014 behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Regime dependency: strong downtrends break 200 EMA",
    "Liquidity constraints: slower stocks have execution lag",
    "Crowding: Ashwani Gujral style widely followed on X"
  ],
  "prior_art": "200 EMA dip + multi-day support (Ashwani Gujral X post)",
  "notes": "Long-only; aggregates to 5-min for EMA."
}
