        "close > VWAP * 0.99",
        "India_VIX < 25"
      ],
      "entry_short": [
        "RSI(close, 2) > 95",
        "RSI(close, 14) > 30 AND RSI(close, 14) < 70",
        "close < VWAP * 1.01",
        "India_VIX < 25"
      ],
      "exit_target": "RSI(close, 2) crosses 60 (longs) or crosses 40 (shorts) \u2014 momentum normalized",
