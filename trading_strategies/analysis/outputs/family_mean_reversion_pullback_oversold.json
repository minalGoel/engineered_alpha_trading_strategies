      "filters": [
        "India_VIX < 25; RSI extremes are less reliable in panic",
        "no entries before 09:30 or after 14:45 (fast trades ok late in day)",
        "volume on extreme bar > 0.8x SMA(volume, 20)",
        "RSI(14) between 30-70 ensures we are not fighting a strong trend",
        "bid-ask spread < 0.04% (tight spread essential for scalp-like trades)"
      ],
      "weaknesses": [
