      "filters": [
        "vix < 25",
        "entry only 09:45-13:00 (morning trend)",
        "pullback bar volume < avg volume (light selling = healthy pullback)",
        "return_from_open > 0.5% is the trend filter",
        "skip if spread > 0.08%"
      ],
      "weaknesses": [
