      "exit_target": "2.0 * atr_20 from entry",
      "exit_stop": "1.0 * atr_20 from entry or close below ema_50 (whichever is tighter)",
      "filters": [
        "vix < 25",
        "no entries in first 30 min (need trend to establish) or last 30 min",
        "volume > SMA(volume, 20) on pullback bar",
        "adx_14 > 25 is the trend filter",
        "skip if spread > 0.08%"
      ],
      "weaknesses": [
        "Sub-50% win rate means long drawdown periods; need strong conviction to keep trading through losses",
        "ADX > 25 filter on 1-min bars is slow to react \u2014 trend may reverse before ADX catches up",
        "On choppy days, false trends form and collapse, generating multiple small losses"
      ],
      "prior_art": "EMA pullback trend following \u2014 standard trend-following concept adapted for 1-min intraday"
    },
