{
  "strategy_name": "spot_momentum_v1",
  "category": "momentum",
  "thesis": "15-30 second spot momentum predicts continuation for the next 30-60 seconds. Momentum is a well-documented short-term microstructure effect — aggressive order flow takes time to fully execute.",
  "signal_source": "SPOT_DIRECTION",
  "underlying": "NIFTY",
  "indicators": {
    "mom_6": "6-bar (30s) spot price change",
    "mom_3": "3-bar (15s) spot price change for confirmation"
  },
  "entry": {
    "buy_ce": "mom_6 > momentum_threshold AND mom_3 > 0",
    "buy_pe": "mom_6 < -momentum_threshold AND mom_3 < 0"
  },
  "exit": {
    "stop": "3-5 option premium points",
    "target": "8-12 option premium points",
    "time_stop": "18 bars (90 seconds)"
  },
  "tunable_params": {
    "momentum_threshold": {"default": 8.0, "range": [5.0, 15.0]},
    "stop_pts": {"default": 4.0, "range": [2.0, 6.0]},
    "target_pts": {"default": 8.0, "range": [5.0, 12.0]}
  },
  "session_filter": "09:18-15:25 IST",
  "max_trades_per_day": 15,
  "backtest_results": {
    "default_trades": 180,
    "default_gross_pnl": -11648,
    "default_net_pnl": -58071
  }
}
