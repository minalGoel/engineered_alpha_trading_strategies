{
  "name": "index_momentum_v1",
  "version": "0.1.0",
  "author": "AI_Quant",
  "tags": [
    "momentum",
    "market"
  ],
  "thesis": "This strategy trades based on index momentum. It enters long (short) when the Nifty50's 5-minute return is strongly positive (negative), exploiting the tendency of individual stocks to follow overall market moves (market beta). This inefficiency exists because index movements (often driven by institutional flows or macro announcements) are not always fully anticipated by individual stock prices. It persists due to market friction and the broad-based nature of moves.",
  "universe": "nifty50",
  "stock_filter": "equal_weight",
  "timeframe": "1min",
  "session": "09:20-15:15",
  "hold_time": "1-10 bars",
  "max_hold_bars": 10,
  "trades_per_day": "5-10",
  "max_trades_per_day": 10,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": false,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "nifty5m_return",
      "formula": "(nifty50_close - nifty50_close[5]) / nifty50_close[5] * 100",
      "lookback": 5,
      "purpose": "market short-term return"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "index_return_5 > 0.2"
      ],
      "confirmation": ""
    },
    "short": {
      "conditions": [
        "index_return_5 < -0.2"
      ],
      "confirmation": ""
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "0.3%",
    "stop_loss": "0.3%",
    "trailing_stop": "none",
    "time_stop": "flatten at 15:29",
    "eod_rule": "flatten",
    "signal_exit": ""
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.2,
    "position_sizing": "fixed",
    "max_open_positions": 5,
    "max_daily_loss_inr": 100000,
    "max_portfolio_heat_pct": 50.0
  },
  "filters": {
    "vix_filter": "",
    "time_filter": "",
    "volume_filter": "none",
    "trend_filter": "",
    "spread_filter": "",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 20,
    "win_rate_estimate": 0.5,
    "avg_winner_to_loser": 1.2,
    "profit_factor_estimate": 1.0,
    "edge_decay_risk": "medium \u2014 crowding"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Only works if stock is highly correlated with index; idiosyncratic moves break the setup",
    "Small edge due to broad-based nature, may not overcome costs",
    "Index returns may already price in general market sentiment"
  ],
  "prior_art": "Index momentum following",
  "notes": "Example: go long banking stocks when Bank Nifty has strong momentum.",
  "_filepath": "all_trading_strategies/gpt/GPT_10_of_10.json",
