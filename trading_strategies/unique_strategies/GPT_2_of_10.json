{
  "name": "vwap_mean_reversion_v1",
  "version": "0.1.0",
  "author": "AI_Quant",
  "tags": [
    "mean_reversion",
    "vwap"
  ],
  "thesis": "This strategy exploits intraday mean reversion to VWAP. In range-bound or oscillating markets, price often spikes away and then returns to the VWAP (seen as the intraday 'fair value' line)\u30108\u2020L137-L142\u3011. This inefficiency arises from short-term overreactions and institutional VWAP-centric execution. It persists because many traders under-utilize VWAP and because reverting trades require precise timing amid noise.",
  "universe": "nifty50",
  "stock_filter": "top_liquid_nifty50",
  "timeframe": "1min",
  "session": "09:20-15:15",
  "hold_time": "1-10 bars",
  "max_hold_bars": 10,
  "trades_per_day": "3-5",
  "max_trades_per_day": 5,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": false,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "vwap_zscore",
      "formula": "(close - vwap) / STD(close, 30)",
      "lookback": 30,
      "purpose": "deviation from fair value"
    },
    {
      "name": "avgvol30",
      "formula": "SMA(volume, 30)",
      "lookback": 30,
      "purpose": "baseline volume"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "close < vwap AND vwap_zscore < -1.5 AND volume > 2 * avgvol30"
      ],
      "confirmation": ""
    },
    "short": {
      "conditions": [
        "close > vwap AND vwap_zscore > 1.5 AND volume > 2 * avgvol30"
      ],
      "confirmation": ""
    },
    "entry_price": "close of signal bar"
  },
  "exit": {
    "target": "vwap touch",
    "stop_loss": "0.3% from entry",
    "trailing_stop": "none",
    "time_stop": "flatten at 15:29",
    "eod_rule": "flatten",
    "signal_exit": ""
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.5,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 100000,
    "max_portfolio_heat_pct": 50.0
  },
  "filters": {
    "vix_filter": "",
    "time_filter": "skip first 10 bars",
    "volume_filter": "none",
    "trend_filter": "index_return_15 between -0.5% and 0.5%",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 25,
    "win_rate_estimate": 0.55,
    "avg_winner_to_loser": 1.8,
    "profit_factor_estimate": 1.8,
    "edge_decay_risk": "medium \u2014 structural"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Fails in strong trending regimes (trend continues beyond VWAP)",
    "Relies on accurate VWAP calculation, can give false signals in low volume",
    "Potential slippage if reversal is sharp (fast moves)"
  ],
  "prior_art": "Classic VWAP reversion",
  "notes": "No overnight hold; known mean-reversion behavior around institutional VWAP.",
  "_filepath": "all_trading_strategies/gpt/GPT_2_of_10.json",
  "_dedup_metadata": {
    "original_path": "all_trading_strategies/gpt/GPT_2_of_10.json",
    "phase1_survived": true,
    "phase2_survived": true,
