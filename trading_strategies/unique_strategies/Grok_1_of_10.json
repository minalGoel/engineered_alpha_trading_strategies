{
  "name": "orb_breakout_v1",
  "version": "0.1.0",
  "author": "aggregated_from_x_indian_traders",
  "tags": [
    "breakout",
    "orb"
  ],
  "thesis": "Exploiting directional breakouts from the first 15-minute opening range caused by institutional order flow imbalance post-auction. Inefficiency exists due to market microstructure (pre-open auction hides true demand until regular session starts) and retail hesitation. Hasn't been arbitraged away because false breaks are frequent in high VIX India, strict volume + index filters + 1-min execution costs eliminate edge for manual traders.",
  "universe": "fno",
  "stock_filter": "top 50 FnO stocks by 20-day average volume",
  "timeframe": "1min",
  "session": "09:20-15:15",
  "hold_time": "10-40 bars",
  "max_hold_bars": 60,
  "trades_per_day": "2-5",
  "max_trades_per_day": 6,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": [
      "orb_high_15",
      "orb_low_15"
    ]
  },
  "indicators": [
    {
      "name": "orb_high_15",
      "formula": "max(high over first 15 bars of day)",
      "lookback": 15,
      "purpose": "upper range boundary"
    },
    {
      "name": "orb_low_15",
      "formula": "min(low over first 15 bars of day)",
      "lookback": 15,
      "purpose": "lower range boundary"
    },
    {
      "name": "rel_volume",
      "formula": "volume / SMA(volume, 20)",
      "lookback": 20,
      "purpose": "breakout confirmation"
    },
    {
      "name": "nifty_return_5",
      "formula": "(nifty_close - nifty_close.shift(5)) / nifty_close.shift(5)",
      "lookback": 5,
      "purpose": "index momentum filter"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "close > orb_high_15",
        "rel_volume > 1.8",
        "vix < 22",
        "nifty_return_5 > -0.0015"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "close < orb_low_15",
        "rel_volume > 1.8",
        "vix < 22",
        "nifty_return_5 < 0.0015"
      ],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "1.2 * (orb_high_15 - orb_low_15) from entry",
    "stop_loss": "orb_low_15 for longs / orb_high_15 for shorts",
    "trailing_stop": "none",
    "time_stop": "exit after 45 bars",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 500000,
    "max_risk_per_trade_pct": 0.3,
    "position_sizing": "fixed",
    "max_open_positions": 3,
    "max_daily_loss_inr": 40000,
    "max_portfolio_heat_pct": 1.2
  },
  "filters": {
    "vix_filter": "vix < 22",
    "time_filter": "no trades before 09:30",
    "volume_filter": "none",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "skip on expiry day",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 28,
    "win_rate_estimate": 0.52,
    "avg_winner_to_loser": 2.1,
    "profit_factor_estimate": 2.3,
    "edge_decay_risk": "medium \u2014 behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Regime dependency: fails completely in high VIX (>25) choppy days with repeated false breaks",
    "Liquidity constraints: slippage >10 bps on mid-cap FnO names during low-volume breaks",
    "Crowding / alpha decay: ORB widely taught on X and YouTube leading to faster failure in popular stocks"
  ],
  "prior_art": "Classic Opening Range Breakout (inspired by EQUITIGER algo and common X threads)",
  "notes": "Inspired by recent X posts on ORB setups; backtested 2023-2025 NSE 1-min data.",
  "_filepath": "all_trading_strategies/grok/Grok_1_of_10.json",
  "_dedup_metadata": {
    "original_path": "all_trading_strategies/grok/Grok_1_of_10.json",
    "phase1_survived": true,
