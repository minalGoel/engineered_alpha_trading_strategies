  "indicators": [
    {
      "name": "vwap_zscore",
      "formula": "(close - vwap) / ATR(14)",
      "lookback": null,
      "purpose": "pullback depth"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "vwap_zscore < -0.8",
        "rel_volume > 1.5",
        "vix < 19",
        "nifty_return_5 > 0.001"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "vwap_zscore > 0.8",
        "rel_volume > 1.5",
        "vix < 19",
        "nifty_return_5 < -0.001"
      ],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "vwap touch",
    "stop_loss": "1.2 * ATR(14)",
    "trailing_stop": "none",
    "time_stop": "exit after 25 bars",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 350000,
    "max_risk_per_trade_pct": 0.25,
    "position_sizing": "fixed",
    "max_open_positions": 3,
    "max_daily_loss_inr": 30000,
