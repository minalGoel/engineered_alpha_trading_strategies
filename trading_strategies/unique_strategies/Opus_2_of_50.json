{
  "name": "bollinger_squeeze_reversion_v1",
  "version": "0.1.0",
  "author": "claude_strategist",
  "tags": [
    "mean_reversion",
    "bollinger",
    "volatility"
  ],
  "thesis": "After a Bollinger Band squeeze (bandwidth contracts to 20-bar low), the first breakout often fails and reverts. This happens because low-vol environments attract breakout traders who pile in, but insufficient momentum causes a mean reversion to the midline. In Indian large-caps, algos front-run the breakout causing an overshoot followed by reversion. Edge persists because breakout traders and mean reversion traders are structurally different populations with different timeframes.",
  "universe": "nifty50",
  "stock_filter": "top 30 by 20-day avg turnover",
  "timeframe": "1min",
  "session": "09:30-14:30",
  "hold_time": "15-45 bars",
  "max_hold_bars": 60,
  "trades_per_day": "1-3",
  "max_trades_per_day": 4,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "bb_upper",
      "formula": "SMA(close, 20) + 2 * STDDEV(close, 20)",
      "lookback": 20,
      "purpose": "upper Bollinger band"
    },
    {
      "name": "bb_lower",
      "formula": "SMA(close, 20) - 2 * STDDEV(close, 20)",
      "lookback": 20,
      "purpose": "lower Bollinger band"
    },
    {
      "name": "bb_mid",
      "formula": "SMA(close, 20)",
      "lookback": 20,
      "purpose": "midline target"
    },
    {
      "name": "bb_bandwidth",
      "formula": "(bb_upper - bb_lower) / bb_mid",
      "lookback": 20,
      "purpose": "squeeze detection"
    },
    {
      "name": "bb_bandwidth_pctile",
      "formula": "PERCENTILE_RANK(bb_bandwidth, 120)",
      "lookback": 120,
      "purpose": "is bandwidth at 2-hour low"
    },
    {
      "name": "atr_20",
      "formula": "ATR(high, low, close, 20)",
      "lookback": 20,
      "purpose": "stop sizing"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "bb_bandwidth_pctile < 20",
        "close < bb_lower",
        "close > bb_lower - 0.5 * atr_20",
        "vix < 22"
      ],
      "confirmation": "close of next bar > close of signal bar"
    },
    "short": {
      "conditions": [
        "bb_bandwidth_pctile < 20",
        "close > bb_upper",
        "close < bb_upper + 0.5 * atr_20",
        "vix < 22"
      ],
      "confirmation": "close of next bar < close of signal bar"
    },
    "entry_price": "market on confirmation bar close"
  },
  "exit": {
    "target": "bb_mid (SMA 20) touch",
    "stop_loss": "0.4% from entry",
    "trailing_stop": "move SL to breakeven after +0.25%",
    "time_stop": "exit if open > 60 bars",
    "eod_rule": "flatten",
    "signal_exit": "exit when close crosses bb_mid"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.4,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 4000,
    "max_portfolio_heat_pct": 2.0
  },
  "filters": {
    "vix_filter": "vix < 22",
    "time_filter": "no trades first 15 min or last 15 min",
    "volume_filter": "rel_volume > 0.8 (not dead tape)",
    "trend_filter": "none",
    "spread_filter": "skip if spread > 0.1%",
    "event_filter": "skip on expiry day",
    "other_filters": [
      "skip if stock gapped > 1% at open"
    ]
  },
  "edge": {
    "expected_bps": 20,
    "win_rate_estimate": 0.55,
    "avg_winner_to_loser": 1.15,
    "profit_factor_estimate": 1.41,
    "edge_decay_risk": "medium \u2014 behavioral; more algos detect squeeze patterns over time"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Squeeze can resolve into a genuine breakout instead of reverting \u2014 especially on news days",
    "The 20-bar lookback on 1-min data is noisy; false squeeze signals in choppy markets",
    "Limited trade frequency \u2014 squeeze setups may only appear 1-2 times per day across the universe"
  ],
  "prior_art": "Bollinger Band squeeze (John Bollinger); failed breakout mean reversion is well-documented",
  "notes": "Consider adaptive bandwidth percentile lookback based on recent VIX regime.",
