{
  "name": "partial_gap_fill_scalp_v1",
  "version": "0.1.0",
  "author": "claude_strategist",
  "tags": [
    "gap",
    "scalp",
    "partial_fill"
  ],
  "thesis": "Medium gaps (0.5%-1.5%) often partially fill (50-70% of the gap) before finding support/resistance. Rather than targeting a full gap fill, this strategy targets a partial fill \u2014 which has a higher probability of occurring. The partial fill level acts as a magnet because institutional VWAP algorithms anchor to the previous close, creating pull-back flow. Edge persists because most gap traders target full fills and get stopped out when the gap doesn't fully close.",
  "universe": "nifty50",
  "stock_filter": "top 25 by avg daily turnover",
  "timeframe": "1min",
  "session": "09:20-10:30",
  "hold_time": "10-45 bars",
  "max_hold_bars": 75,
  "trades_per_day": "0-2",
  "max_trades_per_day": 3,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": [
      "prev_day_close"
    ]
  },
  "indicators": [
    {
      "name": "gap_pct",
      "formula": "(open_of_day - prev_day_close) / prev_day_close * 100",
      "lookback": 1,
      "purpose": "gap size"
    },
    {
      "name": "partial_fill_target",
      "formula": "open_of_day - 0.5 * (open_of_day - prev_day_close)",
      "lookback": 1,
      "purpose": "50% gap fill level"
    },
    {
      "name": "rsi_7",
      "formula": "RSI(close, 7)",
      "lookback": 7,
      "purpose": "oversold/overbought confirmation"
    },
    {
      "name": "atr_20",
      "formula": "ATR(high, low, close, 20)",
      "lookback": 20,
      "purpose": "stop sizing"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "gap_pct < -0.5 AND gap_pct > -1.5 (gap down 0.5-1.5%)",
        "rsi_7 < 30",
        "time > 09:20"
      ],
      "confirmation": "first green bar after rsi_7 < 30"
    },
    "short": {
      "conditions": [
        "gap_pct > 0.5 AND gap_pct < 1.5 (gap up 0.5-1.5%)",
        "rsi_7 > 70",
        "time > 09:20"
      ],
      "confirmation": "first red bar after rsi_7 > 70"
    },
    "entry_price": "market on confirmation bar close"
  },
  "exit": {
    "target": "partial_fill_target (50% gap fill)",
    "stop_loss": "0.4% beyond the gap direction",
    "trailing_stop": "none",
    "time_stop": "exit by 10:30",
    "eod_rule": "flatten",
    "signal_exit": "close reaches partial_fill_target"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.4,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 4000,
    "max_portfolio_heat_pct": 1.5
  },
  "filters": {
    "vix_filter": "vix < 22",
    "time_filter": "entry only 09:20-09:45; manage until 10:30",
    "volume_filter": "opening volume > 80% of 20-day avg opening volume",
    "trend_filter": "nifty50 gap in same direction (don't fight macro)",
    "spread_filter": "skip if spread > 0.1%",
    "event_filter": "skip on stock results day, budget day",
    "other_filters": [
      "gap must be 0.5-1.5% \u2014 below 0.5% is noise, above 1.5% is news-driven"
    ]
  },
  "edge": {
    "expected_bps": 25,
    "win_rate_estimate": 0.62,
    "avg_winner_to_loser": 0.85,
    "profit_factor_estimate": 1.39,
    "edge_decay_risk": "low \u2014 gap dynamics are structural"
  },
  "costs": {
    "slippage_bps_per_side": 4,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Opening slippage (4+ bps) eats into edge significantly",
    "Partial fill target is arbitrary \u2014 50% may not be the optimal level for all stocks",
    "On strong momentum days, gap extends instead of filling even partially"
  ],
  "prior_art": "Gap fill with partial target \u2014 adaptation of classic gap fill to increase win rate",
  "notes": "Backtest partial fill rates at 25%, 50%, 75% to find optimal target per stock.",
  "_filepath": "all_trading_strategies/opus/Opus_30_of_50.json",
  "_dedup_metadata": {
    "original_path": "all_trading_strategies/opus/Opus_30_of_50.json",
    "phase1_survived": true,
    "phase2_survived": true,
    "phase3_survived": true,
    "was_duplicate_kill": false,
    "family": "gap momentum intraday",
    "num_within_family_comparisons": 1,
    "variant_pairs": [
      "all_trading_strategies/cursor_opus46max/cursor_opus46max_strategy_062.json"
    ],
    "different_pairs": []
  }
}