{
  "name": "gap_fade_reversion_v106",
  "version": "1.0.0",
  "author": "QuantGen_Subagent_2",
  "tags": [
    "gap",
    "mean_reversion"
  ],
  "thesis": "Overnight gaps caused by retail overreaction or minor news are often overextended. Institutional participants use the morning liquidity to fade the gap and revert to previous day's value area. Exists due to overnight liquidity vacuums.",
  "universe": "nifty50",
  "stock_filter": "top 50 by avg volume in universe",
  "timeframe": "5min",
  "session": "09:30-15:15",
  "hold_time": "10-30 bars",
  "max_hold_bars": 15,
  "trades_per_day": "2-5",
  "max_trades_per_day": 8,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "prev_close",
      "formula": "REF(close, 1, 'day')",
      "lookback": 1,
      "purpose": "gap reference"
    },
    {
      "name": "gap_pct",
      "formula": "(open - prev_close) / prev_close",
      "lookback": 1,
      "purpose": "gap size"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "gap_pct < -20 AND close > open AND volume > SMA(volume, 5)"
      ],
      "confirmation": "volume surge"
    },
    "short": {
      "conditions": [
        "gap_pct > 20 AND close < open AND volume > SMA(volume, 5)"
      ],
      "confirmation": "volume surge"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "prev_close (Gap Fill)",
    "stop_loss": "1.5 * ATR(14) below entry",
    "trailing_stop": "move SL to breakeven after +0.5%",
    "time_stop": "exit after 15 bars",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 200000,
    "max_risk_per_trade_pct": 1.0,
    "position_sizing": "vol_adjusted",
    "max_open_positions": 3,
    "max_daily_loss_inr": 5000,
    "max_portfolio_heat_pct": 3.0
  },
  "filters": {
    "vix_filter": "vix < 25",
    "time_filter": "only 09:30-14:30",
    "volume_filter": "none",
    "trend_filter": "none",
    "spread_filter": "skip if bid-ask > 0.05%",
    "event_filter": "skip on RBI policy days",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 20.0,
    "win_rate_estimate": 0.59,
    "avg_winner_to_loser": 1.81,
    "profit_factor_estimate": 2.62,
    "edge_decay_risk": "medium \u2014 behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Runaway gaps (gap and go) will trigger maximum stop losses",
    "Earnings or major macroeconomic news can completely invalidate the mean reversion thesis",
    "Often crowded trade in the first 15 minutes"
  ],
  "prior_art": "Morning Gap Fade",
