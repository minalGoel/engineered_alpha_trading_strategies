{
  "name": "mean_reversion_hull_ma",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": [
    "mean_reversion"
  ],
  "thesis": "Exploits the lag-less nature of Hull Moving Average (HMA). When price deviates too far from the 50-bar HMA and the HMA slope is flat, a reversion is imminent. Behavioral bias: traders see the price moving away and chase it, creating the extreme deviation required for the snap-back.",
  "universe": "fno",
  "stock_filter": "stocks with ATR(14)/Price > 0.01",
  "timeframe": "1min",
  "session": "10:30-14:30",
  "hold_time": "10-40 bars",
  "max_hold_bars": 60,
  "trades_per_day": "3-6",
  "max_trades_per_day": 15,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": false,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "hma_50",
      "formula": "WMA(2*WMA(close, 25) - WMA(close, 50), sqrt(50))",
      "lookback": 50,
      "purpose": "mean"
    },
    {
      "name": "dist_hma",
      "formula": "(close - hma_50) / close",
      "lookback": 0,
      "purpose": "deviation"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "dist_hma < -0.01",
        "hma_50 > hma_50[1]"
      ],
      "confirmation": "close > prev_high"
    },
    "short": {
      "conditions": [
        "dist_hma > 0.01",
        "hma_50 < hma_50[1]"
      ],
      "confirmation": "close < prev_low"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "hma_50 touch",
    "stop_loss": "0.4% from entry",
    "trailing_stop": "none",
    "time_stop": "30 bars",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.4,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 2000,
    "max_portfolio_heat_pct": 0.8
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "mid-session",
    "volume_filter": "none",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 22.5,
    "win_rate_estimate": 0.55,
    "avg_winner_to_loser": 1.5,
    "profit_factor_estimate": 1.83,
    "edge_decay_risk": "medium \u2014 structural"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Requires high volatility to hit 1% deviation",
    "Slope filter can be noisy"
  ],
  "prior_art": "Alan Hull HMA strategies",
  "notes": "Computationally intensive for 1-min bars on all NSE stocks.",
  "_filepath": "all_trading_strategies/gemini/gemini_15_of_20.json",
  "_dedup_metadata": {
    "original_path": "all_trading_strategies/gemini/gemini_15_of_20.json",
    "phase1_survived": true,
    "phase2_survived": true,
    "phase3_survived": true,
    "was_duplicate_kill": false,
    "family": "hull-ma weighted-ma low-lag",
    "num_within_family_comparisons": 1,
    "variant_pairs": [
      "all_trading_strategies/cursor_opus46max/cursor_opus46max_strategy_035.json"
    ],
    "different_pairs": []
  }
}