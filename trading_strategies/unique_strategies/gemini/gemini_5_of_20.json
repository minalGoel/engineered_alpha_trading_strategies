{
  "name": "vwap_pinch_breakout",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": [
    "momentum",
    "breakout"
  ],
  "thesis": "Exploits a 'volatility squeeze' between two anchors of price. When the 1-min 20 EMA and VWAP converge (the 'pinch'), it indicates a balance of power. The breakout from this range typically carries institutional force as one side gives up. This is an information-based inefficiency.",
  "universe": "nifty100",
  "stock_filter": "top 20 by avg range",
  "timeframe": "1min",
  "session": "full_day",
  "hold_time": "20-60 bars",
  "max_hold_bars": 120,
  "trades_per_day": "2-4",
  "max_trades_per_day": 12,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": false,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "ema_20",
      "formula": "EMA(close, 20)",
      "lookback": 20,
      "purpose": "dynamic_anchor"
    },
    {
      "name": "pinch",
      "formula": "abs(ema_20 - vwap) / close < 0.001",
      "lookback": 0,
      "purpose": "volatility_compression"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "pinch == True",
        "close > ema_20",
        "close > vwap",
        "volume > prev_volume"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "pinch == True",
        "close < ema_20",
        "close < vwap",
        "volume > prev_volume"
      ],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "3 * ATR(20) from entry",
    "stop_loss": "0.3% from entry",
    "trailing_stop": "move to breakeven after +0.3%",
    "time_stop": "none",
    "eod_rule": "flatten",
    "signal_exit": "ema_20 crosses vwap"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.3,
    "position_sizing": "fixed",
    "max_open_positions": 4,
    "max_daily_loss_inr": 2500,
    "max_portfolio_heat_pct": 1.2
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "09:30-15:00",
    "volume_filter": "none",
    "trend_filter": "none",
    "spread_filter": "spread < 0.03%",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 24.0,
    "win_rate_estimate": 0.48,
    "avg_winner_to_loser": 2.0,
    "profit_factor_estimate": 1.84,
    "edge_decay_risk": "low \u2014 structural"
  },
  "costs": {
    "slippage_bps_per_side": 2,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Whipsaws in choppy mid-session",
    "Requires liquid stocks to avoid gap slippage"
  ],
  "prior_art": "Original - Pinch variant",
  "notes": "Pinch threshold (0.1%) is tunable based on stock volatility.",
  "_filepath": "all_trading_strategies/gemini/gemini_5_of_20.json",
  "_dedup_metadata": {
    "original_path": "all_trading_strategies/gemini/gemini_5_of_20.json",
    "phase1_survived": true,
    "phase2_survived": true,
    "phase3_survived": true,
    "was_duplicate_kill": false,
    "family": "breakout momentum volatility",
    "num_within_family_comparisons": 1,
    "variant_pairs": [
      "all_trading_strategies/cursor_gpt54/cursor_gpt54_squeeze_release_breakout_001.json"
    ],
    "different_pairs": []
  }
}