{
  "name": "gap_momentum_continuation",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": [
    "momentum",
    "gap"
  ],
  "thesis": "Exploits 'Information Momentum'. Gaps > 2% on the open usually indicate significant overnight fundamental news (earnings, orders). The first 15 mins of volume confirms if institutions are buying the news or fading it. Continuation occurs when the 15-min high is broken on high relative volume.",
  "universe": "nifty200",
  "stock_filter": "gap > 2% or gap < -2%",
  "timeframe": "1min",
  "session": "09:30-11:30",
  "hold_time": "60-120 bars",
  "max_hold_bars": 180,
  "trades_per_day": "1-2",
  "max_trades_per_day": 5,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": false,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "gap_pct",
      "formula": "(open - prev_close) / prev_close",
      "lookback": 1,
      "purpose": "selection"
    },
    {
      "name": "range_15",
      "formula": "highest(high, 15) @ 09:30",
      "lookback": 15,
      "purpose": "trigger"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "gap_pct > 0.02",
        "close > range_15",
        "volume > sma(volume, 20) * 1.5"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "gap_pct < -0.02",
        "close < range_15",
        "volume > sma(volume, 20) * 1.5"
      ],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "fixed 1.2%",
    "stop_loss": "0.6% from entry",
    "trailing_stop": "move to BE at +0.6%",
    "time_stop": "none",
    "eod_rule": "flatten",
    "signal_exit": "close crosses vwap"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.8,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 3000,
    "max_portfolio_heat_pct": 1.6
  },
  "filters": {
    "vix_filter": "vix < 25",
    "time_filter": "09:30-11:30",
    "volume_filter": "rel_vol > 1.5",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 38.0,
    "win_rate_estimate": 0.46,
    "avg_winner_to_loser": 2.1,
    "profit_factor_estimate": 1.79,
    "edge_decay_risk": "low \u2014 structural"
  },
  "costs": {
    "slippage_bps_per_side": 5,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Gap fills (reversals) are common",
    "High slippage on high-momentum names"
  ],
  "prior_art": "Gap and Go",
  "notes": "Avoid trading during major macro event days like Budget day.",
  "_filepath": "all_trading_strategies/gemini/gemini_11_of_20.json",
  "_dedup_metadata": {
    "original_path": "all_trading_strategies/gemini/gemini_11_of_20.json",
    "phase1_survived": true,
    "phase2_survived": true,
    "phase3_survived": true,
    "was_duplicate_kill": false,
    "family": "gap mean_reversion momentum",
    "num_within_family_comparisons": 4,
    "variant_pairs": [],
    "different_pairs": [
      "all_trading_strategies/cursor_gemini31pro/cursor_gemini31pro_strategy_103.json",
      "all_trading_strategies/cursor_gemini31pro/cursor_gemini31pro_strategy_116.json",
      "all_trading_strategies/cursor_gemini31pro/cursor_gemini31pro_strategy_106.json",
      "all_trading_strategies/cursor_gemini31pro/cursor_gemini31pro_strategy_104.json"
    ]
  }
}