{
  "name": "vix_spike_mean_reversion",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": [
    "volatility",
    "mean_reversion"
  ],
  "thesis": "Exploits 'Volatility Overpricing'. A sudden 5% spike in India VIX within 10 minutes often leads to an over-reaction in Nifty 50 component prices. As VIX stabilizes, the delta-hedging pressure from option writers subsides, leading to a quick price recovery. This is a market microstructure constraint.",
  "universe": "nifty50",
  "stock_filter": "all constituents",
  "timeframe": "1min",
  "session": "full_day",
  "hold_time": "15-45 bars",
  "max_hold_bars": 60,
  "trades_per_day": "1-2",
  "max_trades_per_day": 10,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "vix_spike",
      "formula": "(vix - vix[10]) / vix[10] > 0.05",
      "lookback": 10,
      "purpose": "trigger"
    },
    {
      "name": "rsi_14",
      "formula": "RSI(close, 14)",
      "lookback": 14,
      "purpose": "oversold_check"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "vix_spike == True",
        "rsi_14 < 30",
        "close < vwap"
      ],
      "confirmation": "close > open"
    },
    "short": {
      "conditions": [
        "vix_spike == True",
        "rsi_14 > 70",
        "close > vwap"
      ],
      "confirmation": "close < open"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "fixed 0.6%",
    "stop_loss": "0.3% from entry",
    "trailing_stop": "none",
    "time_stop": "30 bars",
    "eod_rule": "flatten",
    "signal_exit": "vix returns to baseline"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.5,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 2000,
    "max_portfolio_heat_pct": 1.0
  },
  "filters": {
    "vix_filter": "vix > 15",
    "time_filter": "none",
    "volume_filter": "none",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 29.0,
    "win_rate_estimate": 0.56,
    "avg_winner_to_loser": 1.5,
    "profit_factor_estimate": 1.91,
    "edge_decay_risk": "medium \u2014 structural"
  },
  "costs": {
    "slippage_bps_per_side": 4,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "VIX spikes can lead to sustained crashes (regime change)",
    "Slippage is high during high VIX"
  ],
  "prior_art": "Volatility Alpha",
  "notes": "Requires high-quality forward-filled VIX data.",
