  ],
  "thesis": "Exploits 'liquidity hunting' at major pivots. The Previous Day High (PDH) and Low (PDL) are significant levels where retail traders place stop orders. Price often 'tags' these levels, executes the stops (liquidity grab), and then reverses. Institutional algos fade these moves once liquidity is tapped.",
  "universe": "nifty100",
  "stock_filter": "all constituents",
  "timeframe": "1min",
  "session": "full_day",
  "hold_time": "20-50 bars",
  "max_hold_bars": 100,
  "trades_per_day": "1-2",
  "max_trades_per_day": 8,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": false,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "pdh",
      "formula": "prev_day_high",
      "lookback": 375,
      "purpose": "level"
    },
    {
      "name": "pdl",
      "formula": "prev_day_low",
      "lookback": 375,
      "purpose": "level"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "low < pdl",
        "close > pdl",
        "rsi(14) < 30"
      ],
      "confirmation": "close > open"
    },
    "short": {
      "conditions": [
        "high > pdh",
        "close < pdh",
        "rsi(14) > 70"
      ],
      "confirmation": "close < open"
    },
    "entry_price": "market"
  },
  "exit": {
