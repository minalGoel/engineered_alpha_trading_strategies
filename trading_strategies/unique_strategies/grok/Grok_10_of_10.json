  "thesis": "Exploiting reversals at 2+ day support/resistance with high-low pattern change. Inefficiency from institutional accumulation at levels. Not arbitraged due to multi-day filter + volume + VIX requirement.",
  "universe": "nifty200",
  "stock_filter": "stocks with clear 2-day S/R",
  "timeframe": "1min",
  "session": "09:20-15:15",
  "hold_time": "12-35 bars",
  "max_hold_bars": 50,
  "trades_per_day": "2-5",
  "max_trades_per_day": 6,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": [
      "prior_day_support"
    ]
  },
  "indicators": [
    {
      "name": "s_r_level",
      "formula": "price touched same level 2+ days",
      "lookback": null,
      "purpose": "level"
    },
    {
      "name": "hl_reversal",
      "formula": "higher low to lower high pattern break",
      "lookback": 5,
      "purpose": "reversal"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "close near s_r_level",
        "hl_reversal == True",
        "rel_volume > 1.5",
        "vix < 20"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "close near s_r_level",
        "hl_reversal == True",
        "rel_volume > 1.5",
        "vix < 20"
      ],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "next S/R level",
    "stop_loss": "0.8 * ATR(20)",
    "trailing_stop": "none",
    "time_stop": "exit after 40 bars",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 300000,
    "max_risk_per_trade_pct": 0.3,
    "position_sizing": "fixed",
    "max_open_positions": 3,
    "max_daily_loss_inr": 25000,
