{
  "name": "vwap_pivot_rejection_v1",
  "version": "0.1.0",
  "author": "aggregated_from_x_indian_traders",
  "tags": [
    "vwap",
    "pivot"
  ],
  "thesis": "Exploiting rejection/pullback at VWAP + pivot zone confluence due to institutional benchmark execution. Inefficiency from retail ignoring multi-confirmation. Survives because zone width filter + index direction required; manual traders can't execute at scale.",
  "universe": "fno",
  "stock_filter": "top 50 FnO",
  "timeframe": "1min",
  "session": "09:20-15:15",
  "hold_time": "8-25 bars",
  "max_hold_bars": 40,
  "trades_per_day": "4-8",
  "max_trades_per_day": 10,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": true,
    "index": "nifty50",
    "option_chain": false,
    "order_book": false,
    "other": [
      "pivot_s4",
      "pivot_r1"
    ]
  },
  "indicators": [
    {
      "name": "vwap_pivot_zone",
      "formula": "abs(vwap - pivot_s4) < 0.2% OR abs(vwap - pivot_r1) < 0.2%",
      "lookback": null,
      "purpose": "confluence zone"
    },
    {
      "name": "rejection",
      "formula": "doji or pinbar at zone",
      "lookback": 1,
      "purpose": "entry trigger"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "vwap_pivot_zone == True",
        "price above zone AND rejection == True",
        "vix < 20"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "vwap_pivot_zone == True",
        "price below zone AND rejection == True",
        "vix < 20"
      ],
      "confirmation": "none"
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "next pivot level",
    "stop_loss": "0.6 * ATR(20) below entry",
    "trailing_stop": "move to breakeven after +0.4%",
    "time_stop": "none",
    "eod_rule": "flatten",
    "signal_exit": "none"
  },
  "risk": {
    "capital_per_trade": 400000,
    "max_risk_per_trade_pct": 0.25,
    "position_sizing": "fixed",
    "max_open_positions": 3,
    "max_daily_loss_inr": 40000,
    "max_portfolio_heat_pct": 1.0
  },
  "filters": {
    "vix_filter": "vix < 20",
    "time_filter": "no trades before 09:30",
    "volume_filter": "none",
    "trend_filter": "none",
    "spread_filter": "none",
    "event_filter": "none",
    "other_filters": [
      "zone_width < 80 points"
    ]
  },
  "edge": {
    "expected_bps": 24,
    "win_rate_estimate": 0.59,
    "avg_winner_to_loser": 1.7,
    "profit_factor_estimate": 2.4,
    "edge_decay_risk": "medium \u2014 behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Regime dependency: fails when zone is wide (>0.2%)",
    "Liquidity constraints: pivot levels crowded on expiry",
    "Crowding: heavily shared on X by multiple educators"
  ],
  "prior_art": "VWAP + Pivot combo (popularized by @learntotrade365 on X)",
  "notes": "Multiple chart examples from X; requires daily pivot calc.",
