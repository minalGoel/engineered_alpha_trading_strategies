{
  "name": "pullback_to_vwap_trend_ride",
  "version": "1.0.0",
  "author": "Gemini Quant",
  "tags": [
    "trend_following"
  ],
  "thesis": "Exploits the 'buy the dip' institutional bias. In a trending market (high ADX), VWAP acts as the 'fair price'. Institutions looking to add to positions wait for price to touch VWAP to minimize market impact. This creates a high-probability bounce. It hasn't been arbitraged because it requires distinct trend identification to separate from mean reversion.",
  "universe": "nifty200",
  "stock_filter": "ADX > 30 and daily gain > 2%",
  "timeframe": "1min",
  "session": "10:30-15:00",
  "hold_time": "30-90 bars",
  "max_hold_bars": 180,
  "trades_per_day": "1-2 per stock",
  "max_trades_per_day": 6,
  "data": {
    "ohlcv_1min": true,
    "vwap": true,
    "vix": false,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "adx_14",
      "formula": "ADX(14)",
      "lookback": 14,
      "purpose": "trend_strength"
    },
    {
      "name": "dist_to_vwap",
      "formula": "abs(close - vwap) / close",
      "lookback": 0,
      "purpose": "entry_timing"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "adx_14 > 30",
        "plus_di > minus_di",
        "dist_to_vwap < 0.001",
        "close > open"
      ],
      "confirmation": "none"
    },
    "short": {
      "conditions": [
        "adx_14 > 30",
        "minus_di > plus_di",
        "dist_to_vwap < 0.001",
        "close < open"
      ],
      "confirmation": "none"
    },
    "entry_price": "limit at vwap"
  },
  "exit": {
    "target": "3 * ATR(14) from entry",
    "stop_loss": "0.4% from entry",
    "trailing_stop": "1.5 * ATR trail",
    "time_stop": "none",
    "eod_rule": "flatten",
    "signal_exit": "adx crosses below 25"
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.4,
    "position_sizing": "fixed",
    "max_open_positions": 2,
    "max_daily_loss_inr": 2000,
    "max_portfolio_heat_pct": 0.8
  },
  "filters": {
    "vix_filter": "none",
    "time_filter": "after 10:30",
    "volume_filter": "none",
    "trend_filter": "adx > 30",
    "spread_filter": "spread < 0.05%",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 25.0,
    "win_rate_estimate": 0.5,
    "avg_winner_to_loser": 1.9,
    "profit_factor_estimate": 1.9,
    "edge_decay_risk": "low \u2014 structural"
  },
  "costs": {
    "slippage_bps_per_side": 2,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Sudden trend reversals ('V' tops)",
    "VWAP fails if the trend is parabolic"
  ],
  "prior_art": "Classic VWAP Trend Strategy",
  "notes": "Uses limit orders to reduce slippage cost.",
  "_filepath": "all_trading_strategies/gemini/gemini_8_of_20.json",
  "_dedup_metadata": {
    "original_path": "all_trading_strategies/gemini/gemini_8_of_20.json",
    "phase1_survived": true,
    "phase2_survived": true,
    "phase3_survived": true,
    "was_duplicate_kill": false,
    "family": null,
    "num_within_family_comparisons": 0,
    "variant_pairs": [],
    "different_pairs": []
  }
}