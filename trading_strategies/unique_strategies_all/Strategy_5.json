{
  "name": "bollinger_band_reversion_v1",
  "version": "0.1.0",
  "author": "AI_Quant",
  "tags": [
    "mean_reversion"
  ],
  "thesis": "This strategy exploits mean reversion at Bollinger Bands. When price touches or breaches the lower/upper band, a reversal to the mean often follows\u30106\u2020L395-L403\u3011. The inefficiency arises as short-term extreme moves overshoot the normal trading range. It persists because volatility clusters and traders often overreact to quick spikes, with the realignment to average unfolding over subsequent minutes.",
  "universe": "nifty500",
  "stock_filter": "top_liquid_nifty500",
  "timeframe": "1min",
  "session": "09:20-15:15",
  "hold_time": "1-10 bars",
  "max_hold_bars": 10,
  "trades_per_day": "5-10",
  "max_trades_per_day": 10,
  "data": {
    "ohlcv_1min": true,
    "vwap": false,
    "vix": false,
    "index": "none",
    "option_chain": false,
    "order_book": false,
    "other": []
  },
  "indicators": [
    {
      "name": "bb_upper",
      "formula": "SMA(close, 20) + 2 * STD(close, 20)",
      "lookback": 20,
      "purpose": "upper band"
    },
    {
      "name": "bb_lower",
      "formula": "SMA(close, 20) - 2 * STD(close, 20)",
      "lookback": 20,
      "purpose": "lower band"
    },
    {
      "name": "bb_mid",
      "formula": "SMA(close, 20)",
      "lookback": 20,
      "purpose": "middle band (mean)"
    }
  ],
  "entry": {
    "long": {
      "conditions": [
        "close < bb_lower"
      ],
      "confirmation": ""
    },
    "short": {
      "conditions": [
        "close > bb_upper"
      ],
      "confirmation": ""
    },
    "entry_price": "market"
  },
  "exit": {
    "target": "bb_mid (SMA20)",
    "stop_loss": "0.4% from entry",
    "trailing_stop": "none",
    "time_stop": "flatten at 15:29",
    "eod_rule": "flatten",
    "signal_exit": ""
  },
  "risk": {
    "capital_per_trade": 100000,
    "max_risk_per_trade_pct": 0.3,
    "position_sizing": "fixed",
    "max_open_positions": 3,
    "max_daily_loss_inr": 50000,
    "max_portfolio_heat_pct": 30.0
  },
  "filters": {
    "vix_filter": "",
    "time_filter": "",
    "volume_filter": "volume > 1.5 * avg_20",
    "trend_filter": "",
    "spread_filter": "",
    "event_filter": "none",
    "other_filters": []
  },
  "edge": {
    "expected_bps": 25,
    "win_rate_estimate": 0.6,
    "avg_winner_to_loser": 2.0,
    "profit_factor_estimate": 1.8,
    "edge_decay_risk": "medium \u2014 behavioral"
  },
  "costs": {
    "slippage_bps_per_side": 3,
    "brokerage": "zerodha_intraday",
    "stt_bps": 2.5,
    "exchange_charges_bps": 0.5
  },
  "weaknesses": [
    "Strong trends can keep price on the band (breakouts) causing large losses",
    "Works poorly in sudden news events where volatility spikes persist",
    "Requires good volume to confirm reversals, low liquidity can cause false signals"
  ],
  "prior_art": "Classic Bollinger band mean reversion",
  "notes": "Common mean-reversion play. Sensitive to band parameters.",
  "_filepath": "all_trading_strategies/gpt/GPT_5_of_10.json",
  "_dedup_metadata": {
