  ],
  "max_hold_bars": 36,
  "max_trades_per_day": 10,
  "thesis": "This strategy exploits volatility expansion after intraday compression resolves with direction and volume. The inefficiency exists because traders reduce risk during compression and then chase once the move is obvious, and it persists because many breakouts fail without participation, so timing and capacity remain constrained.",
  "mechanism": "Volatility compression (squeeze) indicates that market makers have tightened their quotes around a narrow range. When a catalyst breaks the equilibrium, the compressed energy releases as participants rush to reposition. The thin order book beyond the compression zone allows rapid price movement with minimal resistance.",
  "indicators": [
    {
      "name": "vwap",
      "formula": "VWAP()",
      "lookback": 4680,
      "computed_on": "spot",
      "purpose": "intraday fair value anchor"
    },
    {
      "name": "atr_14",
      "formula": "ATR(168)",
      "lookback": 168,
      "computed_on": "spot",
      "purpose": "volatility normalization"
    },
    {
      "name": "rel_volume_20",
      "formula": "volume / SMA(volume, 240)",
      "lookback": 240,
      "computed_on": "spot",
      "purpose": "participation filter"
    },
    {
      "name": "bb_upper",
      "formula": "SMA(close, 240) + 2 * STDDEV(close, 20)",
      "lookback": 240,
      "computed_on": "spot",
      "purpose": "compression envelope"
    },
    {
      "name": "bb_lower",
      "formula": "SMA(close, 240) - 2 * STDDEV(close, 20)",
      "lookback": 240,
      "computed_on": "spot",
      "purpose": "compression envelope"
    },
    {
      "name": "kc_upper",
      "formula": "EMA(close, 240) + 1.5 * ATR(20)",
      "lookback": 240,
      "computed_on": "spot",
      "purpose": "compression envelope"
    },
    {
      "name": "kc_lower",
      "formula": "EMA(close, 240) - 1.5 * ATR(20)",
      "lookback": 240,
      "computed_on": "spot",
      "purpose": "compression envelope"
    },
    {
      "name": "squeeze_on",
      "formula": "bb_upper < kc_upper AND bb_lower > kc_lower",
      "lookback": 240,
      "computed_on": "spot",
      "purpose": "compression state"
    },
    {
      "name": "ema_short",
      "formula": "EMA(close, 108)",
      "lookback": 108,
      "computed_on": "spot",
      "purpose": "directional trigger"
    },
    {
      "name": "ema_long",
      "formula": "EMA(close, 252)",
      "lookback": 252,
      "computed_on": "spot",
      "purpose": "directional trigger"
    },
    {
      "name": "squeeze_high",
      "formula": "HIGHEST(high, 120)",
      "lookback": 120,
      "computed_on": "spot",
      "purpose": "break level"
    },
    {
      "name": "squeeze_low",
      "formula": "LOWEST(low, 120)",
      "lookback": 120,
      "computed_on": "spot",
      "purpose": "break level"
    }
  ],
  "entry": {
    "buy_ce": {
      "conditions": [
        "squeeze_on == True",
        "close > squeeze_high",
        "ema_short > ema_long",
        "close > vwap",
        "rel_volume_20 >= 1.2"
      ]
    },
    "buy_pe": {
      "conditions": [
        "squeeze_on == True",
        "close < squeeze_low",
        "ema_short < ema_long",
        "close < vwap",
        "rel_volume_20 >= 1.2"
      ]
    },
    "strike_selection": "ATM",
    "delta_filter": "abs(delta) > 0.35"
  },
  "exit": {
    "target_points": 7,
    "stop_points": 4,
    "time_stop_bars": 18,
    "signal_exit": "exit when close closes back inside squeeze range",
    "eod_flatten": "15:25 IST"
  },
  "filters": {
    "time_filter": "no entries before 09:18 or after 15:20",
    "vix_filter": "India VIX < 25",
    "volume_filter": "require rel_volume_20 >= 1.2",
    "expiry_filter": ""
  },
  "risk": {
    "lots_per_trade": "sized from allocated capital",
    "max_loss_per_trade_points": 4,
    "max_daily_loss_inr": 25000,
    "max_concurrent_positions": 1
  },
  "cost_model": {
    "spread_per_side": 1.0,
